{
    "description": "Library that allows you to easily create REST APIs in DataFlex.",
    "df": 26.0,
    "package": {
        "df-max": 26.0,
        "df-min": 26.0,
        "htmlIncludes": [
            "WebApi/swagger-ui-bundle.js",
            "WebApi/swagger-ui-standalone-preset.js",
            "WebApi/SwaggerDocumentation.js"
        ],
        "icon": "Logo.png",
        "install": [
            "${AppHtml}/WebApi/*"
        ],
        "version": "1.0.0"
    },
    "paths": {
        "fileList": "DummyFilelist.cfg"
    },
    "workspaceName": "Web API Framework"
}