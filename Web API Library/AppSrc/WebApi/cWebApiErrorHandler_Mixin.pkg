Use WebApi\tWebApiReportedError.pkg

#IFDEF IS$CROSS_PLATFORM
Use WebApi\CrossPlatform\cWebApiErrorCompatibility_Mixin.pkg
#ELSE
Use WebApi\Windows\cWebApiErrorCompatibility_Mixin.pkg
#ENDIF


Class cWebApiErrorHandler_Mixin is a Mixin

    Procedure Define_cWebApiErrorHandler_Mixin
        //Marks if an unexpected error occured
        {Visibility = Private}
        Property Boolean pbUnexpectedError False

        {Visibility = Private}
        Property String[] pasErrorCallstack
        // Stores the actual DataFlex error message from the most recent Error_Report call.
        {Visibility = Private}
        Property String psLastErrorMessage ""
        //When running in debug mode more details are returned in the response body
        Property Boolean pbDebugMode False
        {Visibility = Private}
        Property String psLastErrorMessage ""
        {Visibility = Private}
        Property tWebApiReportedError[] paReportedErrors
    End_Procedure
    Import_Class_Protocol cWebApiErrorCompatibility_Mixin

    Procedure Error_Report Integer ErrNum Integer Err_Line String sErrMsg
        Boolean bDebugMode
        String sFormattedMsg sCaption
        String[] asCallstack

        Get pbDebugMode to bDebugMode
        //If a error is reported we should remember that it happened.
        Move (SFormat("Error %1 at line %2: %3", ErrNum, Err_Line, sErrMsg)) to sFormattedMsg
        Send RecordReportedError ErrNum Err_Line sErrMsg
        Send Error_Report of ghoErrorHandler ErrNum Err_Line sErrMsg

        // If we are running in the debugger forward it.
        If (IsDebuggerPresent() or bDebugMode) Begin
            Get pasErrorCallstack to asCallstack
            Move sFormattedMsg to asCallstack[-1]
            Set pasErrorCallstack to asCallstack

            //If we run in debug mode pop up the error window
            If (IsDebuggerPresent()) Begin
                Get ErrorDescription ErrNum sErrMsg to sCaption
                ErrorDisplay ERR_Line sErrMsg sCaption C_$OK C_$Copy
            End
        End
    End_Procedure

    // Remembers a reported DataFlex error for HttpErrorMessage and the DDP error handling.
    { Visibility = Private }
    Procedure RecordReportedError Integer ErrNum Integer Err_Line String sErrMsg
        tWebApiReportedError reported
        tWebApiReportedError[] aErrors

        Set pbUnexpectedError to True
        Set psLastErrorMessage to (SFormat("Error %1 at line %2: %3", ErrNum, Err_Line, sErrMsg))
        Move ErrNum to reported.iNumber
        Move Err_Line to reported.iLine
        Get ErrorDescription ErrNum sErrMsg to reported.sText
        Get paReportedErrors to aErrors
        Move reported to aErrors[SizeOfArray(aErrors)]
        Set paReportedErrors to aErrors
    End_Procedure

    //Should start trapping errors and mark itself as the error object
    Procedure StartErrorTracking
        String[] asEmptyArray
        tWebApiReportedError[] aNoErrors

        Set pasErrorCallstack to asEmptyArray
        Set psLastErrorMessage to ""
        Set paReportedErrors to aNoErrors
        Move Self to Error_Object_Id
    End_Procedure

    //Should stop trapping errors and mark the old error object as Error_Object_ID
    Procedure StopErrorTracking
        String[] asEmptyArray
        tWebApiReportedError[] aNoErrors

        //Reset variables
        Move ghoErrorHandler to Error_Object_Id
        Set pasErrorCallstack to asEmptyArray
        Set psLastErrorMessage to ""
        Set pbUnexpectedError to False
        Set psLastErrorMessage to ""
        Set paReportedErrors to aNoErrors
    End_Procedure

    { Visibility = Private }
    Function WebApiLastErrorMessage Returns String
        Function_Return (psLastErrorMessage(Self))
    End_Function

    { Visibility = Private }
    Function WebApiReportedErrors Returns tWebApiReportedError[]
        Function_Return (paReportedErrors(Self))
    End_Function

    //Should return the error message when running in debug mode
    Function HttpErrorMessage Returns String
        Boolean bDebugMode
        String sErrorMessage

        Get pbDebugMode to bDebugMode
        //Should return a vague error message when not running in debug mode. More details when running in debug mode
        If (bDebugMode or IsDebuggerPresent()) Begin
            Get DetailedErrorMessage to sErrorMessage
        End
        // Always fall back to the stored error message so callers see the actual problem.
        If (sErrorMessage = "") Begin
            Get psLastErrorMessage to sErrorMessage
        End
        If (sErrorMessage = "") Begin
            Move "Something went wrong on the server" to sErrorMessage
        End

        Function_Return sErrorMessage
    End_Function

    //Should be called when running in pbDebugMode
    Function DetailedErrorMessage Returns String
        String[] asErrorMessage
        String sCombinedErrorMessage sCurrentCallstack
        Integer iIndex

        Get pasErrorCallstack to asErrorMessage

        //Print out all the error callstacks if we are in debug mode
        For iIndex from 0 to (SizeOfArray(asErrorMessage)-1)
            Move asErrorMessage[iIndex] to sCurrentCallstack
            Move (Replaces(Character(13)+Character(10),sCurrentCallstack, " ")) to sCurrentCallstack
            Append sCombinedErrorMessage " " sCurrentCallstack
        Loop

        Function_Return sCombinedErrorMessage
    End_Function

    { Visibility = Private }
    Function ErrorDescription Integer iError String sMessage Returns String
        String sDescription

        Get CompatibilityErrorDescription iError sMessage to sDescription

        Function_Return sDescription
    End_Function

End_Class
