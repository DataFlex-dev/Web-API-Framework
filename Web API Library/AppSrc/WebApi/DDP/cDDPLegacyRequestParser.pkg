Use WebApi\DDP\cDDPRequestParser.pkg

// Parses the Legacy query format (DDPFormat header absent or "Legacy"): the root keys are
// table names and each value is a table query object such as
// {"__limit":10, "Name_ge":"A", "Name_di":"asc", "OrderHeader":{...}}.
// See DataDictionaryProtocol.md. This format is kept as-is; new features target DbMessage.
Class cDDPLegacyRequestParser is a cDDPRequestParser

    // One tDDPQuery per root table, in request order.
    Function ParseQueryRequest Handle hoJson tDDPQuery[] ByRef aQueries Returns tDDPBuilderResult
        tDDPBuilderResult oResult
        tDDPQuery oQuery oEmptyQuery
        Integer iIndex iOrderSequence
        String sName
        Handle hoTable

        For iIndex from 0 to (MemberCount(hoJson) - 1)
            Move (MemberNameByIndex(hoJson, iIndex)) to sName
            Get Member of hoJson sName to hoTable
            Move oEmptyQuery to oQuery
            Move 0 to iOrderSequence
            Get ParseTableQuery sName hoTable (&oQuery.oMain) 0 (&iOrderSequence) to oResult
            Send Destroy of hoTable
            If (oResult.iErr) Function_Return oResult

            Get ValidateOrdering oQuery.oMain to oResult
            If (oResult.iErr) Function_Return oResult

            Move oQuery to aQueries[-1]
        Loop
        Function_Return oResult
    End_Function

    // Resolves a Legacy request key to a constraint or an ordering on hoDD. "Name_ge" (or a
    // bare "Name", meaning equality) gives the 1-based field number in iField and its find
    // mode in eMode. "Name_di" gives iField and sets bOrdering. Returns False when the key
    // matches no field/operator on hoDD.
    Function ResolveConstraintOrOrderingKey Handle hoDD String sKey Integer ByRef iField Integer ByRef eMode Boolean ByRef bOrdering Returns Boolean
        Handle hoProtocol
        Integer iFieldCount iFieldNameLen
        String sFieldName sSuffix
        Get phoProtocol to hoProtocol
        Get FieldCount of hoProtocol hoDD to iFieldCount
        Move False to bOrdering

        // Walk every field on the DD checking for an exact name match first
        // (bare name = equality) then a name+3-char suffix match.
        For iField from 1 to iFieldCount
            Move (FieldName(hoProtocol, hoDD, iField)) to sFieldName
            Move (Length(sFieldName)) to iFieldNameLen

            // Bare field name with no suffix — treat as equality constraint.
            If (Lowercase(sKey) = Lowercase(sFieldName)) Begin
                Move DDPFind_EQ to eMode
                Function_Return True
            End

            // Name + exactly 3 suffix characters (e.g. "_ge", "_di").
            // Lowercase the suffix so the API is case-insensitive.
            If (Lowercase(Left(sKey, iFieldNameLen)) = Lowercase(sFieldName) and Length(sKey) = (iFieldNameLen + 3)) Begin
                Move (Lowercase(Right(sKey, 3))) to sSuffix
                If (sSuffix = "_di") Begin
                    // Ordering directive — caller will build a tDDPOrder entry.
                    Move True to bOrdering
                    Function_Return True
                End
                Else If (sSuffix = "_eq") Begin
                    Move DDPFind_EQ to eMode
                    Function_Return True
                End
                Else If (sSuffix = "_ne") Begin
                    Move DDPFind_NE to eMode
                    Function_Return True
                End
                Else If (sSuffix = "_ge") Begin
                    Move DDPFind_GE to eMode
                    Function_Return True
                End
                Else If (sSuffix = "_gt") Begin
                    Move DDPFind_GT to eMode
                    Function_Return True
                End
                Else If (sSuffix = "_le") Begin
                    Move DDPFind_LE to eMode
                    Function_Return True
                End
                Else If (sSuffix = "_lt") Begin
                    Move DDPFind_LT to eMode
                    Function_Return True
                End
            End
        Loop

        // Key did not match any field on this DD.
        Function_Return False
    End_Function

    // Reads one _di value. A plain "asc"/"desc" is sorted by where it appears in the request.
    // A {"dir": "asc"|"desc", "seq": <number>} value is sorted by seq (lowest first).
    Function ParseOrderDirective Handle hoJson String sKey String sDDName Handle hoDD Integer iField Integer ByRef iOrderSequence tDDPOrder ByRef oOrder Returns tDDPBuilderResult
        tDDPBuilderResult oResult
        Handle hoDirective
        String sValue
        Boolean bValid

        Move hoDD to oOrder.hoDD
        Move iField to oOrder.hField
        Move True to bValid
        If (MemberJsonType(hoJson, sKey) = jsonTypeObject) Begin
            Get Member of hoJson sKey to hoDirective
            Move (HasMember(hoDirective, "dir") and HasMember(hoDirective, "seq")) to bValid
            If (bValid) Move (MemberJsonType(hoDirective, "seq") = jsonTypeInteger) to bValid
            If (bValid) Begin
                Get MemberValue of hoDirective "dir" to sValue
                Get MemberValue of hoDirective "seq" to oOrder.iSequence
            End
            Move True to oOrder.bExplicit
            Send Destroy of hoDirective
        End
        Else Begin
            Get MemberValue of hoJson sKey to sValue
            Move iOrderSequence to oOrder.iSequence
            Increment iOrderSequence
            Move False to oOrder.bExplicit
        End

        // "ASC" and "asc" both work.
        Move (Lowercase(sValue)) to sValue
        If (bValid and sValue = "asc") Move DDPOrder_ASC to oOrder.eMode
        Else If (bValid and sValue = "desc") Move DDPOrder_DESC to oOrder.eMode
        Else Begin
            Move DDPERR_INVALID_ORDER to oResult.iErr
            Move (SFormat("Invalid ordering on field '%1' in '%2'.", sKey, sDDName)) to oResult.sError
        End
        Function_Return oResult
    End_Function

    // Checks that a table and its parents use only one form ("asc"/"desc" or {dir, seq}) and
    // never repeat a seq. Child tables have their own sort order, so each is checked separately.
    Function ValidateOrdering tDDPTableQuery query Returns tDDPBuilderResult
        tDDPBuilderResult oResult
        tDDPOrder[] aOrder
        Integer iIndex
        Handle hoProtocol

        Get phoProtocol to hoProtocol
        Send DDPCollectOrders of hoProtocol query (&aOrder)
        Move (SortArray(aOrder, hoProtocol, RefFunc(DDPCompareOrderSequence))) to aOrder
        For iIndex from 1 to (SizeOfArray(aOrder) - 1)
            If (aOrder[iIndex].bExplicit <> aOrder[0].bExplicit) Begin
                Move DDPERR_INVALID_ORDER to oResult.iErr
                Move (SFormat("Ordering in '%1' mixes 'asc'/'desc' strings with {dir, seq} objects; use one form.", NameOfDD(hoProtocol, query.hoDD))) to oResult.sError
                Function_Return oResult
            End
            If (aOrder[iIndex].iSequence = aOrder[iIndex - 1].iSequence) Begin
                Move DDPERR_INVALID_ORDER to oResult.iErr
                Move (SFormat("Ordering in '%1' uses seq %2 more than once.", NameOfDD(hoProtocol, query.hoDD), aOrder[iIndex].iSequence)) to oResult.sError
                Function_Return oResult
            End
        Loop

        For iIndex from 0 to (SizeOfArray(query.aChilds) - 1)
            Get ValidateOrdering query.aChilds[iIndex] to oResult
            If (oResult.iErr) Function_Return oResult
        Loop
        Function_Return oResult
    End_Function

    // Parses one JSON table-query object (e.g. {"__limit":10, "Name_ge":"A",
    // "OrderHeader": {...}}) into a tDDPTableQuery struct. Called recursively
    // for each nested related table. hoParentDD is the DD handle of the calling
    // table, used to validate that the nested table is directly related.
    // iOrderSequence counts the plain "asc"/"desc" sort fields in the order they appear in
    // the request, including nested tables.
    Function ParseTableQuery String sDDName Handle hoJson tDDPTableQuery ByRef table Handle hoParentDD Integer ByRef iOrderSequence Returns tDDPBuilderResult
        Integer iIndex eType
        String sKey sValue
        tDDPBuilderResult oResult
        Integer iConstrainIndex
        Handle hoProtocol

        Get phoProtocol to hoProtocol
        Move sDDName to table.sRequestedName
        Move hoParentDD to table.hoParentDD
        // Resolve the table name to an exposed DD handle. Lookup is
        // case-insensitive because Expose lowercases names on registration.
        Get DDByName of hoProtocol sDDName to table.hoDD
        If (table.hoDD = 0) Begin
            Move DDPERR_UNKOWN_TABLE to oResult.iErr
            Move (SFormat("'%1', not known.", sDDName)) to oResult.sError
            Function_Return oResult
        End

        // __limit — optional integer cap on rows returned for this table.
        // Defaults to 200; an explicit zero means no limit.
        Move C_WebAPIDDP_Default_Limit to table.iLimit
        Get ReadOptionalNonNegativeInteger hoJson "__limit" DDPERR_INVALID_LIMIT "Invalid limit." (&table.iLimit) to oResult
        If (oResult.iErr) Function_Return oResult

        // __offset — optional integer number of rows to skip before collecting results.
        Get ReadOptionalNonNegativeInteger hoJson "__offset" DDPERR_INVALID_OFFSET "Invalid offset." (&table.iOffset) to oResult
        If (oResult.iErr) Function_Return oResult

        // __fields — optional array of field names to include in the response.
        // Each name is resolved to a 1-based field number so serialization
        // can access fields by index without re-scanning by name at read time.
        Handle hoFields
        Integer iField
        Boolean bFieldsSpecified
        If (HasMember(hoJson, "__fields")) Begin
            Move True to bFieldsSpecified
            Move (MemberJsonType(hoJson, "__fields")) to eType
            If (eType <> jsonTypeArray) Begin
                Move DDPERR_INVALID_FIELDS to oResult.iErr
                Move "Invalid fields." to oResult.sError
                Function_Return oResult
            End

            Get Member of hoJson "__fields" to hoFields

            For iIndex from 0 to (MemberCount(hoFields) - 1)
                Get MemberValue of hoFields iIndex to sValue
                // Reject any name that does not exist on this DD — prevents
                // silent data leakage if a client typos a sensitive field name.
                If (not(IsField(hoProtocol, table.hoDD, sValue, &iField))) Begin
                    Move DDPERR_INVALID_FIELD to oResult.iErr
                    Move "Invalid field." to oResult.sError
                    Function_Return oResult
                End
                // Store each resolved field once for later serialization.
                If (SearchArray(iField, table.aFields) = -1) ;
                    Move iField to table.aFields[-1]
            Loop

            Send Destroy of hoFields
        End

        tDDPOrder oOrder
        tDDPTableQuery oTable oEmptyTable
        Boolean bParent bIsOrdering bResolved
        Handle hoMemberTable
        Integer eResolvedMode

        // Walk remaining JSON members; skip the reserved keys already handled.
        // A member is a sort field ("asc"/"desc" or {dir, seq}), a nested table (object)
        // or a constraint (value).
        For iIndex from 0 to (MemberCount(hoJson) - 1)
            Get MemberNameByIndex of hoJson iIndex to sKey
            If (sKey = "__limit" or sKey = "__offset" or sKey = "__fields") Break Begin

            Move (MemberJsonType(hoJson, sKey)) to eType
            // This also tells us whether the member is a sort field (_di).
            Get ResolveConstraintOrOrderingKey table.hoDD sKey (&iField) (&eResolvedMode) (&bIsOrdering) to bResolved

            If (bResolved and bIsOrdering) Begin
                Get ParseOrderDirective hoJson sKey sDDName table.hoDD iField (&iOrderSequence) (&oOrder) to oResult
                If (oResult.iErr) Function_Return oResult
                Move oOrder to table.aOrder[-1]
            End
            Else If (eType = jsonTypeObject) Begin
                // Nested object — must be a related table name.
                Get DDByName of hoProtocol sKey to oTable.hoDD
                If (oTable.hoDD = 0) Begin
                    Move DDPERR_UNKOWN_TABLE to oResult.iErr
                    Move (SFormat("'%1', not known.", sKey)) to oResult.sError
                    Function_Return oResult
                End

                // Verify a direct relationship exists between this table and
                // the nested one. IsDDRelated also sets bParent to distinguish
                // server-file (parent) from client-file (child) direction.
                If (not(IsDDRelated(hoProtocol, table.hoDD, oTable.hoDD, &bParent))) Begin
                    Move DDPERR_UNKOWN_TABLE to oResult.iErr
                    Move (SFormat("'%1', not related.", sKey)) to oResult.sError
                    Function_Return oResult
                End

                // Recurse to parse the nested table's own constraints and relations.
                Get Member of hoJson sKey to hoMemberTable
                Get ParseTableQuery sKey hoMemberTable (&oTable) table.hoDD (&iOrderSequence) to oResult
                Send Destroy of hoMemberTable

                If (oResult.iErr) Function_Return oResult

                // Slot into the correct relation array based on direction.
                If (bParent) Begin
                    Move oTable to table.aParents[-1]
                End
                Else Begin
                    Move oTable to table.aChilds[-1]
                End

                // Reset the scratch variable for the next iteration.
                Move oEmptyTable to oTable
            End
            Else Begin
                // Scalar value — reject arrays/objects that sneaked past the
                // object branch (defensive check; should not normally occur).
                If (eType = jsonTypeObject or eType = jsonTypeArray) Begin
                    Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                    Move (SFormat("Invalid parameter '%1' in '%2'.", sKey, sDDName)) to oResult.sError
                    Function_Return oResult
                End

                If (not(bResolved)) Begin
                    Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                    Move (SFormat("Invalid parameter field '%1' in '%2'.", sKey, sDDName)) to oResult.sError
                    Function_Return oResult
                End

                Get MemberValue of hoJson sKey to sValue
                Move iField to table.aConstrains[iConstrainIndex].hField
                Move eResolvedMode to table.aConstrains[iConstrainIndex].eMode
                Move sValue to table.aConstrains[iConstrainIndex].aParams[0]
                Increment iConstrainIndex
            End
        Loop
        // Resolve the default field selection after parents have been parsed.
        // Parent relation fields are omitted unless explicitly requested.
        If (not(bFieldsSpecified)) Send ApplyDefaultFields (&table)

        // Put this table's sort fields in sort order. The backends apply them in that order.
        Move (SortArray(table.aOrder, hoProtocol, RefFunc(DDPCompareOrderSequence))) to table.aOrder
        Function_Return oResult
    End_Function

End_Class
