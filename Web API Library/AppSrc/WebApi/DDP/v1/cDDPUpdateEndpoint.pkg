Use WebApi\cBaseRestDataset.pkg
Use WebApi\DDP\Backends\IBackend.pkg
Use WebApi\DDP\cDDPBuilder.pkg

// Handles PUT /ddp/v1/update (replace) and PATCH /ddp/v1/update (partial update).
// The record to update is identified by fields in the request body, not a path ID.
// PK fields in the body locate the record; all other fields are written as new values.
// PUT and PATCH behave identically — Set File_Field_Changed_Value only marks the
// supplied fields as dirty so un-supplied fields retain their current values either way.
// Use Delegate Send/Get to call builder/backend methods on the parent protocol.
Class cDDPUpdateEndpoint is a cBaseRestDataset

    Procedure Construct_Object
        Forward Send Construct_Object

        // Update supports PUT and PATCH only; no read, create, or delete.
        Set pbAllowRead to False
        Set pbAllowCreate to False
        Set pbAllowDelete to False

        // Shared JSON parser for request bodies.
        Object oJson is a cJsonObject
            Set pbRequireAllMembers to False
        End_Object
    End_Procedure

    // Shared implementation for PUT and PATCH — logic is identical for both verbs.
    //
    // Single record:   { "Customer": { "Customer_Number": 42, "Name": "New Name" } }
    // Array of records: [ { "Customer": { "Customer_Number": 42, "Name": "A" } }, ... ]
    //
    // Response: 200 with the updated record(s) serialised back (post-save values).
    { Visibility = Private }
    Procedure ExecuteUpdateRequest tWebApiCallContext ByRef webapicallcontext
        String sRequestBodyString sTableName
        tDDPBuilderResult oResult
        tDDPUpdateQuery oQuery oEmptyQuery
        Handle hoElement hoTableJson hoUpdatedRecord
        Integer iIndex iJsonType iElementCount

        Get RequestDataString to sRequestBodyString
        If (not(ParseString(oJson, sRequestBodyString))) Begin
            Move True to webapicallcontext.bErr
            Move C_WEBAPI_NOTALLOWED to webapicallcontext.iStatusCode
            Move "Invalid format" to webapicallcontext.sShortStatusMessage
            Procedure_Return
        End

        Move (JsonType(oJson)) to iJsonType
        If (iJsonType <> jsonTypeObject and iJsonType <> jsonTypeArray) Begin
            Move True to webapicallcontext.bErr
            Move C_WEBAPI_NOTALLOWED to webapicallcontext.iStatusCode
            Move "Invalid format" to webapicallcontext.sShortStatusMessage
            Move "root must be an object or array." to webapicallcontext.sErrorMessage
            Procedure_Return
        End

        Get Create (RefClass(cJsonObject)) to webapicallcontext.hoResponseBody
        If (iJsonType = jsonTypeArray) Begin
            Send InitializeJsonType of webapicallcontext.hoResponseBody jsonTypeArray
            Move (MemberCount(oJson)) to iElementCount
        End
        Else Begin
            Send InitializeJsonType of webapicallcontext.hoResponseBody jsonTypeObject
            Move 1 to iElementCount
        End

        For iIndex from 0 to (iElementCount - 1)
            If (iJsonType = jsonTypeArray) Begin
                Get Member of oJson iIndex to hoElement
            End
            Else Begin
                Move oJson to hoElement
            End

            // Each element must be a JSON object with exactly one top-level key.
            If (JsonType(hoElement) <> jsonTypeObject or MemberCount(hoElement) <> 1) Begin
                If (iJsonType = jsonTypeArray) Send Destroy of hoElement
                Move True to webapicallcontext.bErr
                Move C_WEBAPI_NOTALLOWED to webapicallcontext.iStatusCode
                Move "Invalid format" to webapicallcontext.sShortStatusMessage
                Move "each entry must be a JSON object with exactly one table key." to webapicallcontext.sErrorMessage
                Procedure_Return
            End

            Get MemberNameByIndex of hoElement 0 to sTableName
            Get Member of hoElement sTableName to hoTableJson

            Move oEmptyQuery to oQuery
            Delegate Get ConstructUpdateScenario sTableName hoTableJson (&oQuery) to oResult
            Send Destroy of hoTableJson
            If (iJsonType = jsonTypeArray) Send Destroy of hoElement

            If (oResult.iErr) Begin
                Delegate Send DestroyUpdateQuery oQuery
                Move True to webapicallcontext.bErr
                Move C_WEBAPI_NOTALLOWED to webapicallcontext.iStatusCode
                Move "Invalid request" to webapicallcontext.sShortStatusMessage
                Move oResult.sError to webapicallcontext.sErrorMessage
                Procedure_Return
            End

            Delegate Get ExecuteUpdate oQuery (&hoUpdatedRecord) to oResult
            Delegate Send DestroyUpdateQuery oQuery

            If (oResult.iErr) Begin
                If (hoUpdatedRecord <> 0) Send Destroy of hoUpdatedRecord
                Move True to webapicallcontext.bErr
                If (oResult.iErr = DDPERR_RECORD_NOT_FOUND) Begin
                    Move C_WEBAPI_NOTFOUND to webapicallcontext.iStatusCode
                    Move "Not Found" to webapicallcontext.sShortStatusMessage
                End
                Else If (oResult.iErr = DDPERR_MISSING_KEY_FIELD) Begin
                    Move C_WEBAPI_NOTALLOWED to webapicallcontext.iStatusCode
                    Move "Missing key field" to webapicallcontext.sShortStatusMessage
                End
                Else If (oResult.iErr = DDPERR_VALIDATION_FAILED) Begin
                    Move 422 to webapicallcontext.iStatusCode
                    Move "Validation Error" to webapicallcontext.sShortStatusMessage
                End
                Else Begin
                    Move 422 to webapicallcontext.iStatusCode
                    Move "Update Error" to webapicallcontext.sShortStatusMessage
                End
                Move oResult.sError to webapicallcontext.sErrorMessage
                Procedure_Return
            End

            // Single object → response is an object keyed by table name.
            // Array → response is a flat array of updated records.
            If (iJsonType = jsonTypeArray) Begin
                Send AddMember of webapicallcontext.hoResponseBody hoUpdatedRecord
            End
            Else Begin
                Send SetMember of webapicallcontext.hoResponseBody sTableName hoUpdatedRecord
            End
            Send Destroy of hoUpdatedRecord
            Move 0 to hoUpdatedRecord
        Loop

        Move C_WEBAPI_OK to webapicallcontext.iStatusCode
    End_Procedure

    { MethodType = Event }
    Procedure OnHttpPut tWebApiCallContext ByRef webapicallcontext
        Send ExecuteUpdateRequest (&webapicallcontext)
    End_Procedure

    { MethodType = Event }
    Procedure OnHttpPatch tWebApiCallContext ByRef webapicallcontext
        Send ExecuteUpdateRequest (&webapicallcontext)
    End_Procedure

End_Class
