Use WebApi\DDP\Backends\IBackend.pkg
Use Db\cDataDictionary.pkg
Use cli.pkg




// Cached topology snapshot for one exposed DD: the flat-file handle used as a
// binary-search key, plus arrays of its direct parent (server-file, 1-to-1)
// and child (client-file, 1-to-N) relationships. Populated once at expose time
// so relationship lookups during request handling are O(log n) without touching
// the live DataFlex DD graph.
Struct tDDPClassicFileInfo
    Handle hFile
    tDDPFileDD[] aParents
    tDDPFileDD[] aChilds
End_Struct

Class cDDP_Backend_Mixin is a IDDP_Backend_Mixin
    Procedure Define_DDP_Backend_Mixin
        // Sorted by hFile; BinarySearchArray is used for all lookups.
        Property tDDPClassicFileInfo[] paFileInfo
    End_Procedure

    Procedure End_Define_DDP_Backend_Mixin
    End_Procedure

    { Visibility = Private }
    // Returns True when every character in sNumber is a digit or a leading minus sign.
    // Used to validate integer constraint values before embedding them in SQL WHERE clauses.
    Function IsNumeric String sNumber Returns Boolean
        String sCompare
        Integer iLength iPosition
        Integer iDecimalSeparator iThousandSeparator

        Move "-0123456789" to sCompare

        Move (Length(sNumber)) to iLength
        For iPosition from 1 to iLength
            If (not(sCompare contains Mid(sNumber, 1, iPosition))) Function_Return False
        Loop
        Function_Return True
    End_Function

    { Visibility = Private }
    // Accepts integers, decimals, and thousands-separated numbers.
    // Used for BCD field values that may carry a decimal point or comma
    // separator before they are embedded in a SQL predicate.
    Function IsOptDottedNumeric String sNumber Returns Boolean
        String sCompare
        Integer iLength iPosition
        Integer iDecimalSeparator iThousandSeparator

        Move "-0123456789.," to sCompare

        Move (Length(sNumber)) to iLength
        For iPosition from 1 to iLength
            If (not(sCompare contains Mid(sNumber, 1, iPosition))) Function_Return False
        Loop
        Function_Return True
    End_Function

    // Verifies that hoDD is a DataDictionary subclass, that its underlying table is
    // open, and that the table supports the SQL filter interface. Called at expose
    // time so misconfiguration errors surface before any request is served.
    Function IsObjectValidDataDictionary Handle hoDD Returns Boolean
        If (IsObjectOfClass(hoDD, (RefClass(DataDictionary))) = False) Begin
            Function_Return False
        End

        Boolean bOk
        Integer iFile
        Get Main_File of hoDD to iFile

        Get_Attribute DF_FILE_OPENED of iFile to bOk
        If (not(bOk)) Begin
            Error DFERR_PROGRAM "Underlying table is not open."
            Function_Return False
        End

        If (not(SupportsSQLFilters(hoDD))) Begin
            Error DFERR_PROGRAM "Underlying table does not support SQL filters."
            Function_Return False
        End

        Function_Return True
    End_Function

    // Returns the DataFlex logical file name for the table behind hoDD.
    Function NameOfDD Handle hoDD Returns String
        String sName
        Integer iFile
        Get Main_File of hoDD to iFile
        Get_Attribute DF_FILE_LOGICAL_NAME of iFile to sName
        Function_Return sName
    End_Function

    // Lower-cased variant used for case-insensitive matching against table names
    // that arrive in the request body (client may use any casing).
    Function LoweredNameOfDD Handle hoDD Returns String
        String sName
        Integer iFile
        Get Main_File of hoDD to iFile
        Get_Attribute DF_FILE_LOGICAL_NAME of iFile to sName
        Function_Return (Lowercase(sName))
    End_Function

    // Returns True when iIndex falls within the range of indexes defined on hoDD's table.
    Function IsValidIndexForDD Handle hoDD Integer iIndex Returns Boolean
        Handle hFile
        Integer iLastIndex
        Get Main_File of hoDD to hFile
        Get_Attribute DF_FILE_LAST_INDEX_NUMBER of hFile to iLastIndex
        Function_Return (iIndex <= iLastIndex)
    End_Function

    // Returns True when hoTest is a direct parent or child of hoDD in the pre-cached
    // topology. The optional third argument bOptParent is set to True if hoTest is a
    // server-file (parent) or False if it is a client-file (child).
    // Rejects queries that try to join unrelated tables by returning False.
    Function IsDDRelated Handle hoDD Handle hoTest Boolean ByRef bOptParent Returns Boolean
        Integer iInfoIndex iIndex
        Handle[] aHandles
        tDDPClassicFileInfo oInfo
        tDDPClassicFileInfo[] aInfo
        Get paFileInfo to aInfo

        // Locate the base DD entry in the sorted topology cache.
        Get Main_File of hoDD to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex = -1) Begin
            Error DFERR_PROGRAM "Non-exposed DD"
            Function_Return False
        End

        // Check server-files (parents, 1-to-1).
        Get Main_File of hoTest to oInfo.hFile
        For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aParents) - 1)
            If (aInfo[iInfoIndex].aParents[iIndex].hFile = oInfo.hFile) Begin
                If (num_arguments > 2) Move True to bOptParent
                Function_Return True
            End
        Loop
        // Check client-files (children, 1-to-N).
        For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aChilds) - 1)
            If (aInfo[iInfoIndex].aChilds[iIndex].hFile = oInfo.hFile) Begin
                If (num_arguments > 2) Move False to bOptParent
                Function_Return True
            End
        Loop

        Function_Return False
    End_Function


    // Event hook raised after a DD is successfully validated and exposed.
    { MethodType=Event }
    Procedure OnExposeDD tDDPDataDictPair Def
    End_Procedure

    // Maps a DataFlex field type/precision pair to the JSON primitive type used when
    // writing that field's value:
    //   BCD with precision > 0  →  jsonTypeDouble   (decimal number)
    //   BCD with precision = 0  →  jsonTypeInteger  (whole number)
    //   everything else         →  jsonTypeString   (dates, text, ASCII, …)
    Function DFTypeToJson Integer eType Integer iPrecision Returns Integer
        If (eType = DF_BCD) Begin
            If (iPrecision) Begin
                Function_Return jsonTypeDouble
            End
            Function_Return jsonTypeInteger
        End
        Function_Return jsonTypeString
    End_Function

    // Selects and caches fields plus their JSON metadata for response output.
    Function DDPSerializedFields tDDPTableQuery query Boolean bForceRelated Returns tDDPSerializedField[]
        Integer[] aFieldNumbers
        Integer iField iFieldCount iParent iRelatedField iIndex
        Integer eType iPrecision
        String sName
        Boolean bRelated
        tDDPSerializedField[] aFields
        tDDPSerializedField oField

        Move query.aFields to aFieldNumbers


        If (bForceRelated) Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Move False to bRelated
                For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                    Get FieldRelation query.hoDD query.aParents[iParent].hoDD iField (&iRelatedField) to bRelated
                    If (bRelated) Break
                Loop
                If (not(bRelated) and query.hoParentDD <> 0) ;
                    Get FieldRelation query.hoDD query.hoParentDD iField (&iRelatedField) to bRelated
                If (bRelated and SearchArray(iField, aFieldNumbers) = -1) ;
                    Move iField to aFieldNumbers[-1]
            Loop
        End

        For iIndex from 0 to (SizeOfArray(aFieldNumbers) - 1)
            Move aFieldNumbers[iIndex] to iField
            Get FieldName query.hoDD iField to sName
            Get FieldType query.hoDD iField to eType
            Get FieldPrecision query.hoDD iField to iPrecision
            Move iField to oField.iField
            Move sName to oField.sName
            Move eType to oField.eType
            Get DFTypeToJson eType iPrecision to oField.eJsonType
            Move oField to aFields[-1]
        Loop

        Function_Return aFields
    End_Function

    // Serializes one field value using precomputed metadata.
    Procedure SerializeFieldValue Handle hoJson tDDPSerializedField field Variant vValue
        Send SetMemberValue of hoJson field.sName field.eJsonType vValue
    End_Procedure

    // Serializes selected fields directly from a live DD buffer.
    Procedure DDPSerializeFieldsToJson Handle hoJson Handle hoDD tDDPSerializedField[] aFields
        Integer iIndex
        Handle hFile
        String sValue
        Variant vValue

        Get Main_File of hoDD to hFile
        For iIndex from 0 to (SizeOfArray(aFields) - 1)
            If (not(Err)) Begin
                Get DDPGetFieldValue hoDD hFile aFields[iIndex].iField to sValue
                If (not(Err)) Begin
                    Move sValue to vValue
                    Send SerializeFieldValue hoJson aFields[iIndex] vValue
                End
            End
        Loop
    End_Procedure
    // Serializes the complete mutation buffer through the classic field reader.
    Procedure SerializeBufferToJson Handle hoJson tDDPTableQuery query Boolean bForceRelated
        tDDPSerializedField[] aFields
        Integer iField iFieldCount

        If (SizeOfArray(query.aFields) = 0) Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Move iField to query.aFields[-1]
            Loop
        End

        Get DDPSerializedFields query bForceRelated to aFields
        Send DDPSerializeFieldsToJson hoJson query.hoDD aFields
    End_Procedure

    // Snapshots the parent/child relationship topology of hoDD into paFileInfo when the
    // DD is first exposed. The array is kept sorted by hFile so BinarySearchArray can
    // answer O(log n) lookups at request time without re-traversing the live DD graph.
    // Calling this procedure a second time for the same DD is safe and does nothing.
    Procedure StoreDDFileLayout Handle hoDD
        Integer iInfoIndex
        Handle hMainFile
        tDDPFileDD oComb
        tDDPClassicFileInfo oInfo
        tDDPClassicFileInfo[] aInfo
        Get paFileInfo to aInfo

        Get Main_File of hoDD to oInfo.hFile
        // BinarySearchArray returns -1 when the key is absent; that is when we insert.
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex <> -1) Begin
            Procedure_Return
        End

        // Collect client-files (children, 1-to-N) along with their companion DD handles.
        Integer iIndex
        For iIndex from 0 to (Client_File_Count(hoDD) - 1)
            Get Client_File of hoDD iIndex to oComb.hFile
            Get DDByFile oComb.hFile to oComb.hoDD
            Move oComb to oInfo.aChilds[-1]
        Loop
        // Collect server-files (parents, 1-to-1) along with their companion DD handles.
        For iIndex from 0 to (Server_File_Count(hoDD) - 1)
            Get Server_File of hoDD iIndex to oComb.hFile
            Get DDByFile oComb.hFile to oComb.hoDD
            Move oComb to oInfo.aParents[-1]
        Loop

        // InsertInArray uses the position returned by BinarySearchArray to insert at
        // the correct slot and keep the array sorted.
        Move (InsertInArray(aInfo, iInfoIndex, oInfo)) to aInfo

        Set paFileInfo to aInfo
    End_Procedure

    // Returns an array of DD handles for all server-file (parent) tables of hoDD.
    Function DDParents Handle hoDD Returns Handle[]
        Integer iIndex iInfoIndex
        Handle[] aHandles
        tDDPClassicFileInfo oInfo
        tDDPClassicFileInfo[] aInfo
        Get paFileInfo to aInfo

        Get Main_File of hoDD to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex <> -1) Begin
            For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aParents) - 1)
                Move aInfo[iInfoIndex].aParents[iIndex].hoDD to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function

    // Returns an array of DD handles for all client-file (child) tables of hoDD.
    Function DDChilds Handle hoDD Returns Handle[]
        Integer iIndex iInfoIndex
        Handle[] aHandles
        tDDPClassicFileInfo oInfo
        tDDPClassicFileInfo[] aInfo
        Get paFileInfo to aInfo

        Get Main_File of hoDD to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex <> -1) Begin
            For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aChilds) - 1)
                Move aInfo[iInfoIndex].aChilds[iIndex].hoDD to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function

    // Returns the primary index number declared by hoDD's underlying table.

    Function PrimaryDDIndex Handle hoDD Returns Integer
        Handle hFile
        Integer iPrimaryIndex
        Get Main_File of hoDD to hFile
        Get_Attribute DF_FILE_PRIMARY_INDEX of hFile to iPrimaryIndex
        Function_Return iPrimaryIndex
    End_Function

    // Returns Classic primary-key fields.
    Function DDPPrimaryKeyFields Handle hoDD Returns Integer[]
        Handle hFile
        Integer iPrimaryIndex iSegmentCount iSegment iField
        Integer[] aFields

        Get PrimaryDDIndex hoDD to iPrimaryIndex
        If (iPrimaryIndex <= 0) Function_Return aFields

        Get Main_File of hoDD to hFile
        Get_Attribute DF_INDEX_NUMBER_SEGMENTS of hFile iPrimaryIndex to iSegmentCount
        For iSegment from 1 to iSegmentCount
            Get_Attribute DF_INDEX_SEGMENT_FIELD of hFile iPrimaryIndex iSegment to iField
            Move iField to aFields[-1]
        Loop

        Function_Return aFields
    End_Function

    // Returns the total number of fields in hoDD's underlying table.
    Function FieldCount Handle hoDD Returns Integer
        Handle hFile
        Integer iFieldCount
        Get Main_File of hoDD to hFile
        Get_Attribute DF_FILE_NUMBER_FIELDS of hFile to iFieldCount
        Function_Return iFieldCount
    End_Function

    // Returns the field name for 1-based field number iField, or "" when out of range.
    Function FieldName Handle hoDD Integer iField Returns String
        Handle hFile
        Integer iFieldCount
        String sFieldName
        Get Main_File of hoDD to hFile
        Get_Attribute DF_FILE_NUMBER_FIELDS of hFile to iFieldCount
        If (iField < 1 or iField > iFieldCount) Begin
            Function_Return ""
        End
        Get_Attribute DF_FIELD_NAME of hFile iField to sFieldName
        Function_Return sFieldName
    End_Function
    // DDP field metadata, relation, and index operations.
    Function FieldType Handle hoDD Integer iField Returns Integer
        Handle hFile
        Integer eType

        Get Main_File of hoDD to hFile
        Get_Attribute DF_FIELD_TYPE of hFile iField to eType
        Function_Return eType
    End_Function

    Function FieldPrecision Handle hoDD Integer iField Returns Integer
        Handle hFile
        Integer iPrecision

        Get Main_File of hoDD to hFile
        Get_Attribute DF_FIELD_PRECISION of hFile iField to iPrecision
        Function_Return iPrecision
    End_Function

    // Finds the parent field related to iField on hoDD.
    Function FieldRelation Handle hoDD Handle hoParentDD Integer iField Integer ByRef iRelatedField Returns Boolean
        Handle hFile hParentFile hRelatedFile

        Move 0 to iRelatedField
        If (hoDD = 0 or hoParentDD = 0 or hoDD = hoParentDD or iField < 1) ;
            Function_Return False

        Get Main_File of hoDD to hFile
        Get Main_File of hoParentDD to hParentFile
        Get_Attribute DF_FIELD_RELATED_FILE of hFile iField to hRelatedFile
        If (hRelatedFile <> hParentFile) Function_Return False

        Get_Attribute DF_FIELD_RELATED_FIELD of hFile iField to iRelatedField
        Function_Return True
    End_Function


    // Converts a backend field type and precision to the DDP schema type.
    Function DDPTypeString Integer eType Integer iPrecision Returns String
        If (eType = DF_BCD) Begin
            If (iPrecision > 0) Function_Return "decimal"
            Function_Return "integer"
        End
        If (eType = DF_DATE) Function_Return "date"
        Function_Return "string"
    End_Function


    // Case-sensitive linear scan for a field by name. Sets iOptField (optional third
    // argument) to the 1-based field number when found. Used during query parsing to
    // validate field names supplied in __fields, constraint keys, and ordering directives.
    Function IsField Handle hoDD String sFieldName Integer ByRef iOptField  Returns Boolean
        Handle hFile
        Integer iField iFieldCount
        String sField
        Get Main_File of hoDD to hFile
        Get_Attribute DF_FILE_NUMBER_FIELDS of hFile to iFieldCount
        For iField from 1 to iFieldCount
            Get_Attribute DF_FIELD_NAME of hFile iField to sField
            If (Lowercase(sField) = Lowercase(sFieldName)) Begin
                If (num_arguments > 2) Move iField to iOptField
                Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    // Creates a temporary DataFlex index when ordering was requested.
    Function CreateIndex Handle hoDD tDDPOrder[] aOrder tDDPConstrain[] aConstrains Integer iLimit Integer iOffset Returns Handle
        Handle hFile
        Integer iIndex iSegment

        If (SizeOfArray(aOrder) = 0) Function_Return (PrimaryDDIndex(Self, hoDD))
        Get Main_File of hoDD to hFile

        Create_Index hFile at iIndex
        Set_Attribute DF_INDEX_NUMBER_SEGMENTS of hFile iIndex to (SizeOfArray(aOrder))
        For iSegment from 1 to (SizeOfArray(aOrder))
            Set_Attribute DF_INDEX_SEGMENT_FIELD of hFile iIndex iSegment to aOrder[iSegment - 1].hField
            Set_Attribute DF_INDEX_SEGMENT_DIRECTION of hFile iIndex iSegment to aOrder[iSegment - 1].eMode
        Loop

        Function_Return iIndex
    End_Function

    // Deletes a temporary index created by CreateIndex.
    // Permanent (non-temporary) indexes are left untouched.
    Procedure DeleteIndex Handle hoDD Integer iIndex
        Handle hFile
        Integer eType
        Get Main_File of hoDD to hFile
        Get_Attribute DF_INDEX_SQL_TYPE of hFile iIndex to eType
        If (eType = DF_INDEX_TEMPORARY) Begin
            Delete_Index hFile iIndex
        End
    End_Procedure

    // Seeds ordering fields for the initial index read.
    // Parent ordering fields are seeded recursively for child traversal.
    Procedure Set_Constrains_To_Buffers tDDPTableQuery query
        Handle hFile
        Integer iIndex
        Get Main_File of query.hoDD to hFile
        For iIndex from 0 to (SizeOfArray(query.aOrder) - 1)
            If (query.aOrder[iIndex].eMode = DDPOrder_ASC) ;
                Fill_Field hFile query.aOrder[iIndex].hField with DF_LOW
            Else If (query.aOrder[iIndex].eMode = DDPOrder_DESC) ;
                Fill_Field hFile query.aOrder[iIndex].hField with DF_HIGH
        Loop
        // Parent buffers must be seeded too; Constrain_File reads from them to scope finds.
        For iIndex from 0 to (SizeOfArray(query.aParents) - 1)
            Send Set_Constrains_To_Buffers query.aParents[iIndex]
        Loop
    End_Procedure

    // Applies one constraint for field hField on table hoDD against the literal value sFilter.
    //
    // SQL filter path for all exposed Windows DDs, including related-table fields:
    //   String values are SQL-escaped and quoted before embedding.
    //   Numeric values are validated with IsOptDottedNumeric to prevent injection.
    //   The operator is appended to psSQLFilter via SQLStrAppend.
    Function AddConstrain Handle hoMainDD Handle hoDD Handle hField Integer eConstrain String sFilter Returns tDDPBuilderResult
        Handle hFile
        String sQuery
        Integer eType
        tDDPBuilderResult oResult
        Get Main_File of hoDD to hFile

        Get_Attribute DF_FIELD_TYPE of hFile hField to eType
        If (eType = DF_ASCII or eType = DF_TEXT) Begin
            // Escape and quote string values before embedding in the SQL fragment.
            Get SQLEscapedStr of hoMainDD sFilter to sFilter
            Move ("'" + sFilter + "'") to sFilter
        End
        Else If (not(IsOptDottedNumeric(Self, sFilter))) Begin
            // Reject non-numeric values for numeric fields before they touch SQL.
            Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
            Move "Invalid constrain should be numeric." to oResult.sError
            Function_Return oResult
        End

        Set pbUseDDSQLFilters of hoMainDD to True
        Get psSQLFilter of hoMainDD to sQuery
        If (eConstrain = DDPFind_EQ) Begin
            Get SQLStrAppend of hoMainDD sQuery (SQLStrFileFieldName(hoDD, hField) + " = " + sFilter) to sQuery
        End
        Else If (eConstrain = DDPFind_GE) Begin
            Get SQLStrAppend of hoMainDD sQuery (SQLStrFileFieldName(hoDD, hField) + " >= " + sFilter) to sQuery
        End
        Else If (eConstrain = DDPFind_GT) Begin
            Get SQLStrAppend of hoMainDD sQuery (SQLStrFileFieldName(hoDD, hField) + " > " + sFilter) to sQuery
        End
        Else If (eConstrain = DDPFind_LE) Begin
            Get SQLStrAppend of hoMainDD sQuery (SQLStrFileFieldName(hoDD, hField) + " <= " + sFilter) to sQuery
        End
        Else If (eConstrain = DDPFind_LT) Begin
            Get SQLStrAppend of hoMainDD sQuery (SQLStrFileFieldName(hoDD, hField) + " < " + sFilter) to sQuery
        End
        Else If (eConstrain = DDPFind_NE) Begin
            Get SQLStrAppend of hoMainDD sQuery (SQLStrFileFieldName(hoDD, hField) + " != " + sFilter) to sQuery
        End
        Else Begin
            Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
            Move "Invalid contrain." to oResult.sError
            Function_Return oResult
        End
        Set psSQLFilter of hoMainDD to sQuery
        Function_Return oResult
    End_Function
    // DDP runtime operations for the Classic data dictionary API.
    Procedure DDPLink Handle hoDD Handle hoRelated Boolean bClient Boolean bConstrain
        If (bClient) ;
            Send Add_Client_File of hoRelated (Main_File(hoDD))
        Send Add_Server_File of hoDD (Main_File(hoRelated))
        Set DDO_Server of hoDD to hoRelated
        If (bConstrain) ;
            Set Constrain_File of hoDD to (Main_File(hoRelated))
    End_Procedure

    Procedure DDPClearRelations Handle hoDD Handle hoOptParentDD
        Handle hFile

        Set pbUseDDSQLFilters of hoDD to False
        Set psSQLFilter of hoDD to ""
        Set Constrain_File of hoDD to 0

        While (Client_File_Count(hoDD))
            Get Client_File of hoDD 0 to hFile
            Send Remove_Client_File of hoDD hFile
        Loop

        While (Server_File_Count(hoDD))
            Get Server_File of hoDD 0 to hFile
            Send Remove_Server_File of hoDD hFile
        Loop

        While (Data_Set_Client_Count(hoDD))
            Get Data_Set_Client of hoDD 0 to hFile
            If (num_arguments <= 1 or hoOptParentDD <> hFile) ;
                Send DDPClearRelations hFile hoDD
            Send Detach_Client of hoDD hFile
        Loop

        While (Data_Set_Server_Count(hoDD))
            Get Data_Set_Server of hoDD 0 to hFile
            If (num_arguments <= 1 or hoOptParentDD <> hFile) ;
                Send DDPClearRelations hFile hoDD
            Send Detach_Server of hoDD hFile
        Loop

        Send Clear of hoDD
    End_Procedure

    Procedure DDPRequestRead Handle hoDD Integer eMode Handle hFile Integer iIndex
        Send Request_Read of hoDD eMode hFile iIndex
    End_Procedure

    Procedure DDPRequestFind Handle hoDD Integer eMode Handle hFile Integer iIndex
        Send Request_Find of hoDD eMode hFile iIndex
    End_Procedure

    Procedure DDPSetFieldValue Handle hoDD Handle hFile Integer iField String sValue
        Set_Field_Value hFile iField to sValue
    End_Procedure

    Procedure DDPSetChangedValue Handle hoDD Handle hFile Integer iField String sValue
        Set File_Field_Changed_Value of hoDD hFile iField to sValue
    End_Procedure

    Function DDPGetFieldValue Handle hoDD Handle hFile Integer iField Returns String
        String sValue
        Get_Field_Value hFile iField to sValue
        Function_Return sValue
    End_Function

    Function DDPCurrentRowID Handle hoDD Handle hFile Returns RowID
        Function_Return (GetRowID(hFile))
    End_Function

    Function DDPValidateDelete Handle hoDD Returns Boolean
        Boolean bError
        Get Validate_Delete of hoDD to bError
        Function_Return bError
    End_Function

    Function DDPErrorText String sFallback Returns String
        String sError
        Get Error_Text LastErr to sError
        If (Trim(sError) = "") Move sFallback to sError
        Function_Return sError
    End_Function

    { Visibility = Private }
    // Rebuilds find constraints recursively.
    Procedure DDPRebuildFindConstraints tDDPTableQuery query
        Integer iIndex

        Send Rebuild_Constraints of query.hoDD
        For iIndex from 0 to (SizeOfArray(query.aParents) - 1)
            Send DDPRebuildFindConstraints query.aParents[iIndex]
        Loop
        For iIndex from 0 to (SizeOfArray(query.aChilds) - 1)
            Send DDPRebuildFindConstraints query.aChilds[iIndex]
        Loop
    End_Procedure

    { Visibility = Private }
    // Applies find constraints recursively.
    Function DDPApplyFindConstraints Handle hoMainDD tDDPTableQuery query Returns tDDPBuilderResult
        tDDPBuilderResult oResult
        Integer iChild

        Get AddConstrainsToCurrentSet hoMainDD query to oResult
        If (oResult.iErr) Function_Return oResult

        For iChild from 0 to (SizeOfArray(query.aChilds) - 1)
            Get DDPApplyFindConstraints hoMainDD query.aChilds[iChild] to oResult
            If (oResult.iErr) Function_Return oResult
        Loop

        Function_Return oResult
    End_Function

    // Prepares and validates a Classic find.
    Function DDPPrepareFind tDDPTableQuery query Returns tDDPBuilderResult
        tDDPBuilderResult oResult

        Get QueryLinkUp query to oResult
        If (oResult.iErr) Function_Return oResult

        Send DDPRebuildFindConstraints query
        Get DDPApplyFindConstraints query.hoDD query to oResult
        Function_Return oResult
    End_Function

    { Visibility = Private }
    // Appends a Classic query directly into its caller-owned JSON destination.
    Function DDPAppendQueryJson tDDPTableQuery query Integer eStyle Handle hoScopeDD RowID riScope Handle hoJson Handle hoSeen Boolean bFieldsOnly Returns tDDPBuilderResult
        tDDPBuilderResult oResult
        tDDPTableQuery childQuery
        tDDPTableQuery[] aEmptyChildQueries
        tDDPSerializedField[] aFields
        tDDPSerializedField[][] aParentFields
        Handle hFile hParentFile hoMain hoRow hoParentJson hoChildJson
        Handle[] ahParents ahChilds aParentSeenSets aChildSeenSets
        Integer iIndex iFindMode iOffset iCollected iParent iChild
        RowID riCurrent riParent
        String sRootName sRowId
        String[] aParentNames aChildNames
        Boolean bFlatRoot bFlatLinked bFailed bEmit bRootPresent bParentPresent
        Boolean bIndexCreated

        Move (eStyle = DDPStyle_FlatLinked) to bFlatLinked
        Move ((eStyle <> DDPStyle_Nested) and hoScopeDD = 0 and not(bFieldsOnly)) to bFlatRoot
        Move 0 to iCollected
        Move False to bFailed
        Move False to bIndexCreated
        If (hoScopeDD <> 0 and IsNullRowID(riScope)) Function_Return oResult

        If (bFlatLinked or bFieldsOnly) ;
            Get DDPSerializedFields query True to aFields
        Else ;
            Get DDPSerializedFields query False to aFields

        If (not(bFieldsOnly)) Begin
            For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                Move (NameOfDD(Self, query.aParents[iParent].hoDD)) to aParentNames[-1]
                If bFlatLinked ;
                    Get DDPSerializedFields query.aParents[iParent] True to aParentFields[-1]
                Else ;
                    Get DDPSerializedFields query.aParents[iParent] False to aParentFields[-1]
            Loop
            For iChild from 0 to (SizeOfArray(query.aChilds) - 1)
                Move (NameOfDD(Self, query.aChilds[iChild].hoDD)) to aChildNames[-1]
            Loop
        End

        If (bFlatRoot and not(bFailed)) Begin
            Get Create (RefClass(cJsonObject)) to hoMain
            If (hoMain <> 0 and not(Err)) Send InitializeJsonType of hoMain jsonTypeArray
            If (hoMain = 0 or Err) Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "JSON response construction failed." to oResult.sError
                Move True to bFailed
            End
            For iParent from 0 to (SizeOfArray(aParentNames) - 1)
                If not(bFailed) Begin
                    Get Create (RefClass(cJsonObject)) to hoParentJson
                    If (hoParentJson <> 0 and not(Err)) ;
                        Send InitializeJsonType of hoParentJson jsonTypeArray
                    If (hoParentJson = 0 or Err) Begin
                        Move DDPERR_FIND_FAILED to oResult.iErr
                        Get DDPErrorText "JSON response construction failed." to oResult.sError
                        Move True to bFailed
                    End
                    Else Begin
                        Move hoParentJson to ahParents[-1]
                        Move 0 to hoParentJson
                        If bFlatLinked Begin
                            Get Create (RefClass(cJsonObject)) to hoParentJson
                            If (hoParentJson <> 0 and not(Err)) ;
                                Send InitializeJsonType of hoParentJson jsonTypeObject
                            If (hoParentJson = 0 or Err) Begin
                                Move DDPERR_FIND_FAILED to oResult.iErr
                                Get DDPErrorText "JSON response construction failed." to oResult.sError
                                Move True to bFailed
                            End
                            Else Begin
                                Move hoParentJson to aParentSeenSets[-1]
                                Move 0 to hoParentJson
                            End
                        End
                    End
                End
                If bFailed Break
            Loop
            For iChild from 0 to (SizeOfArray(aChildNames) - 1)
                If not(bFailed) Begin
                    Get Create (RefClass(cJsonObject)) to hoChildJson
                    If (hoChildJson <> 0 and not(Err)) ;
                        Send InitializeJsonType of hoChildJson jsonTypeArray
                    If (hoChildJson = 0 or Err) Begin
                        Move DDPERR_FIND_FAILED to oResult.iErr
                        Get DDPErrorText "JSON response construction failed." to oResult.sError
                        Move True to bFailed
                    End
                    Else Begin
                        Move hoChildJson to ahChilds[-1]
                        Move 0 to hoChildJson
                        If bFlatLinked Begin
                            Get Create (RefClass(cJsonObject)) to hoChildJson
                            If (hoChildJson <> 0 and not(Err)) ;
                                Send InitializeJsonType of hoChildJson jsonTypeObject
                            If (hoChildJson = 0 or Err) Begin
                                Move DDPERR_FIND_FAILED to oResult.iErr
                                Get DDPErrorText "JSON response construction failed." to oResult.sError
                                Move True to bFailed
                            End
                            Else Begin
                                Move hoChildJson to aChildSeenSets[-1]
                                Move 0 to hoChildJson
                            End
                        End
                    End
                End
                If bFailed Break
            Loop
        End

        If (not(bFailed) and not(bFieldsOnly) and (SizeOfArray(aParentNames) > 0)) ;
            Get Create (RefClass(cJsonObject)) to hoParentJson
        If (not(bFailed)) Get Create (RefClass(cJsonObject)) to hoRow
        If (Err and not(bFailed)) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "JSON response construction failed." to oResult.sError
            Move True to bFailed
        End

        Get Main_File of query.hoDD to hFile
        If (not(bFailed)) Begin
            Get CreateIndex query.hoDD query.aOrder query.aConstrains query.iLimit query.iOffset to iIndex
            Move True to bIndexCreated

            Send Clear of query.hoDD
            Send Set_Constrains_To_Buffers query
            Move (DDPFind_GE - 1) to iFindMode
            Move False to Err
            Send DDPRequestRead query.hoDD iFindMode hFile iIndex
            If Err Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "Find failed." to oResult.sError
                Move True to bFailed
            End
        End

        Move query.iOffset to iOffset
        While (not(bFailed) and HasRecord(query.hoDD) and iOffset)
            Decrement iOffset
            Move False to Err
            Send DDPRequestRead query.hoDD NEXT_RECORD hFile iIndex
            If Err Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "Find failed." to oResult.sError
                Move True to bFailed
            End
        Loop

        While (not(bFailed) and HasRecord(query.hoDD) and ;
            (query.iLimit = 0 or iCollected < query.iLimit))
            Get DDPCurrentRowID query.hoDD hFile to riCurrent
            Move (not(IsNullRowID(riCurrent))) to bRootPresent
            Move True to bEmit

            Move False to Err
            If (hoSeen <> 0) Begin
                If (not(bRootPresent)) Begin
                    Move False to bEmit
                End
                Else Begin
                    Move (SerializeRowID(riCurrent)) to sRowId
                    If (HasMember(hoSeen, sRowId)) Begin
                        Move False to bEmit
                    End
                    Else Begin
                        Send SetMemberValue of hoSeen sRowId jsonTypeBoolean True
                    End
                End
            End
            If Err Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "JSON response construction failed." to oResult.sError
                Move True to bFailed
            End

            If (bEmit and not(bFailed)) Begin
                Move False to Err
                Send InitializeJsonType of hoRow jsonTypeObject
                If bRootPresent ;
                    Send DDPSerializeFieldsToJson hoRow query.hoDD aFields
                If Err Begin
                    Move DDPERR_FIND_FAILED to oResult.iErr
                    Get DDPErrorText "JSON response construction failed." to oResult.sError
                    Move True to bFailed
                End

                If (not(bFailed) and not(bFieldsOnly)) Begin
                    For iParent from 0 to (SizeOfArray(aParentNames) - 1)
                        Get Main_File of query.aParents[iParent].hoDD to hParentFile
                        Get DDPCurrentRowID query.aParents[iParent].hoDD hParentFile to riParent
                        Move (not(IsNullRowID(riParent))) to bParentPresent

                        If (bFlatRoot and bFlatLinked) Begin
                            If bParentPresent Begin
                                Move (SerializeRowID(riParent)) to sRowId
                                If (not(HasMember(aParentSeenSets[iParent], sRowId))) Begin
                                    Send SetMemberValue of aParentSeenSets[iParent] sRowId jsonTypeBoolean True
                                    Send InitializeJsonType of hoParentJson jsonTypeObject
                                    Send DDPSerializeFieldsToJson hoParentJson ;
                                        query.aParents[iParent].hoDD aParentFields[iParent]
                                    If (not(Err)) Send AddMember of ahParents[iParent] hoParentJson
                                End
                            End
                        End
                        Else Begin
                            Send InitializeJsonType of hoParentJson jsonTypeObject
                            If bParentPresent ;
                                Send DDPSerializeFieldsToJson hoParentJson ;
                                    query.aParents[iParent].hoDD aParentFields[iParent]
                            If (not(Err)) Begin
                                If bFlatRoot ;
                                    Send AddMember of ahParents[iParent] hoParentJson
                                Else ;
                                    Send SetMember of hoRow aParentNames[iParent] hoParentJson
                            End
                        End
                        If Err Begin
                            Move DDPERR_FIND_FAILED to oResult.iErr
                            Get DDPErrorText "JSON response construction failed." to oResult.sError
                            Move True to bFailed
                            Break
                        End
                    Loop
                End
            End

            If (not(bFailed) and bEmit and not(bFieldsOnly)) Begin
                For iChild from 0 to (SizeOfArray(aChildNames) - 1)
                    Move query.aChilds[iChild] to childQuery
                    If (bFlatRoot and bFlatLinked) Begin
                        Move 0 to childQuery.iLimit
                        Move 0 to childQuery.iOffset
                        Move aEmptyChildQueries to childQuery.aChilds
                        Get DDPAppendQueryJson childQuery DDPStyle_FlatLinked query.hoDD riCurrent ;
                            ahChilds[iChild] aChildSeenSets[iChild] True to oResult
                    End
                    Else Begin
                        Get Create (RefClass(cJsonObject)) to hoChildJson
                        If (hoChildJson <> 0 and not(Err)) Begin
                            Send InitializeJsonType of hoChildJson jsonTypeArray
                            If Err Begin
                                Move DDPERR_FIND_FAILED to oResult.iErr
                                Get DDPErrorText "JSON response construction failed." to oResult.sError
                            End
                            Else ;
                                Get DDPAppendQueryJson childQuery DDPStyle_Nested query.hoDD riCurrent ;
                                    hoChildJson 0 False to oResult
                            If (not(oResult.iErr) and not(Err)) Begin
                                If bFlatRoot ;
                                    Send AddMember of ahChilds[iChild] hoChildJson
                                Else ;
                                    Send SetMember of hoRow aChildNames[iChild] hoChildJson
                            End
                        End
                        Else If (not(oResult.iErr)) Begin
                            Move DDPERR_FIND_FAILED to oResult.iErr
                            Get DDPErrorText "JSON response construction failed." to oResult.sError
                        End
                        If (Err and not(oResult.iErr)) Begin
                            Move DDPERR_FIND_FAILED to oResult.iErr
                            Get DDPErrorText "JSON response construction failed." to oResult.sError
                        End
                        If (hoChildJson <> 0) Send Destroy of hoChildJson
                        Move 0 to hoChildJson
                    End
                    If (oResult.iErr) Begin
                        Move True to bFailed
                        Break
                    End
                    If Err Begin
                        Move DDPERR_FIND_FAILED to oResult.iErr
                        Get DDPErrorText "JSON response construction failed." to oResult.sError
                        Move True to bFailed
                        Break
                    End
                Loop
            End

            If (not(bFailed) and bEmit) Begin
                If bFlatRoot ;
                    Send AddMember of hoMain hoRow
                Else ;
                    Send AddMember of hoJson hoRow
                If Err Begin
                    Move DDPERR_FIND_FAILED to oResult.iErr
                    Get DDPErrorText "JSON response construction failed." to oResult.sError
                    Move True to bFailed
                End
            End

            If not(bFailed) Begin
                Increment iCollected
                Move False to Err
                Send DDPRequestRead query.hoDD NEXT_RECORD hFile iIndex
                If Err Begin
                    Move DDPERR_FIND_FAILED to oResult.iErr
                    Get DDPErrorText "Find failed." to oResult.sError
                    Move True to bFailed
                End
            End
        Loop

        If (not(bFailed) and bFlatRoot) Begin
            Move query.sRequestedName to sRootName
            If (sRootName = "") Move (NameOfDD(Self, query.hoDD)) to sRootName
            Send SetMember of hoJson sRootName hoMain
            For iParent from 0 to (SizeOfArray(aParentNames) - 1)
                If (not(Err)) Send SetMember of hoJson aParentNames[iParent] ahParents[iParent]
            Loop
            For iChild from 0 to (SizeOfArray(aChildNames) - 1)
                If (not(Err)) Send SetMember of hoJson aChildNames[iChild] ahChilds[iChild]
            Loop
            If Err Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "JSON response construction failed." to oResult.sError
                Move True to bFailed
            End
        End

        If (not(bFailed) and Err) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "JSON response construction failed." to oResult.sError
            Move True to bFailed
        End

        If bIndexCreated Send DeleteIndex query.hoDD iIndex
        If (hoRow <> 0) Send Destroy of hoRow
        If (hoParentJson <> 0) Send Destroy of hoParentJson
        If (hoChildJson <> 0) Send Destroy of hoChildJson
        If (hoMain <> 0) Send Destroy of hoMain
        For iParent from 0 to (SizeOfArray(ahParents) - 1)
            If (ahParents[iParent] <> 0) Send Destroy of ahParents[iParent]
        Loop
        For iChild from 0 to (SizeOfArray(ahChilds) - 1)
            If (ahChilds[iChild] <> 0) Send Destroy of ahChilds[iChild]
        Loop
        For iParent from 0 to (SizeOfArray(aParentSeenSets) - 1)
            If (aParentSeenSets[iParent] <> 0) Send Destroy of aParentSeenSets[iParent]
        Loop
        For iChild from 0 to (SizeOfArray(aChildSeenSets) - 1)
            If (aChildSeenSets[iChild] <> 0) Send Destroy of aChildSeenSets[iChild]
        Loop

        If (not(bFailed)) Begin
        End
        Function_Return oResult
    End_Function

    // Creates the complete response object or array for the requested style.
    Function DDPFetchJson tDDPTableQuery query Integer eStyle Handle ByRef hoJson Returns tDDPBuilderResult
        tDDPBuilderResult oResult
        Boolean bInitialized

        Move 0 to hoJson
        Move False to Err
        Get Create (RefClass(cJsonObject)) to hoJson
        If (hoJson <> 0) Begin
            If (eStyle = DDPStyle_Nested) ;
                Send InitializeJsonType of hoJson jsonTypeArray
            Else ;
                Send InitializeJsonType of hoJson jsonTypeObject
        End
        Move ((hoJson <> 0) and not(Err)) to bInitialized
        If bInitialized Begin
            Get DDPAppendQueryJson query eStyle 0 (NullRowID()) hoJson 0 False to oResult
            If (Err and not(oResult.iErr)) Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "JSON response construction failed." to oResult.sError
            End
        End
        Else Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "JSON response construction failed." to oResult.sError
        End

        If (oResult.iErr) Begin
            If (hoJson <> 0) Send Destroy of hoJson
            Move 0 to hoJson
        End
        Function_Return oResult
    End_Function
End_Class
