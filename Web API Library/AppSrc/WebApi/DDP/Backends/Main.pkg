Use WebApi\DDP\Backends\IBackend.pkg
Use Db\cDataDictionary.pkg
Use Db\cDbQuery.pkg


Function DDPParseISODate Global String sValue Date ByRef dValue Returns Boolean
    Integer iPosition iYear iMonth iDay
    String sCharacter

    If (Length(sValue) <> 10 or Mid(sValue, 1, 5) <> "-" or Mid(sValue, 1, 8) <> "-") ;
        Function_Return False

    For iPosition from 1 to 10
        If (iPosition <> 5 and iPosition <> 8) Begin
            Move (Mid(sValue, 1, iPosition)) to sCharacter
            If (Pos(sCharacter, "0123456789") = 0) Function_Return False
        End
    Loop

    Move (Left(sValue, 4)) to iYear
    Move (Mid(sValue, 2, 6)) to iMonth
    Move (Right(sValue, 2)) to iDay
    Try
        Move (DateSet(iYear, iMonth, iDay)) to dValue
    Catch
        Function_Return False
    End_Try

    Function_Return True
End_Function

// Crossplatform file info for cached lookups
Struct tDDPCrossPlatformFileInfo
    Handle hoDD
    Handle[] aParents
    Handle[] aChilds
End_Struct

Register_Function FetchTable Handle hoModel Variant[] aRowData Integer ByRef iResultCol DbTable hTable Returns tDbTableData
Register_Function SQLFieldName Handle hoModel DbTable hTable DbField hField Returns String

Struct tDDPTableResultLayout
    Handle hoDD
    Integer iDataColumnStart
    Integer iPresenceColumn
End_Struct

Class cDDP_Backend_Mixin is a IDDP_Backend_Mixin
    Procedure Define_DDP_Backend_Mixin
        // Handle to all the exposed DDs
        Property Handle[] paExposedDDs
        // All table info
        Property tDDPCrossPlatformFileInfo[] paFileInfo
        // Acts as an index
    End_Procedure

    Procedure End_Define_DDP_Backend_Mixin
    End_Procedure

    { Visibility = Private }
    Function ExposedDDByEntity Handle hEntity Handle[] aExposedDDs Returns Handle
        Integer iIndex
        Handle hDDEntity

        If (hEntity = 0) Function_Return 0
        For iIndex from 0 to (SizeOfArray(aExposedDDs) - 1)
            Get phEntity of aExposedDDs[iIndex] to hDDEntity
            If (hDDEntity = hEntity) Function_Return aExposedDDs[iIndex]
        Loop

        Function_Return 0
    End_Function

    { Visibility = Private }
    Procedure RebuildDDFileLayout
        Integer iIndex iParent iParentIndex
        Handle hoParent
        Handle[] aExposedDDs aEmpty
        tDDParent[] aDDParents
        tDDPCrossPlatformFileInfo oInfo
        tDDPCrossPlatformFileInfo[] aInfo

        Get paExposedDDs to aExposedDDs
        For iIndex from 0 to (SizeOfArray(aExposedDDs) - 1)
            Move 0 to oInfo.hoDD
            Move aEmpty to oInfo.aParents
            Move aEmpty to oInfo.aChilds
            Move aExposedDDs[iIndex] to oInfo.hoDD

            Get paParents of aExposedDDs[iIndex] to aDDParents
            For iParent from 0 to (SizeOfArray(aDDParents) - 1)
                Get ExposedDDByEntity aDDParents[iParent].hEntity aExposedDDs to hoParent
                If (hoParent <> 0 and SearchArray(hoParent, oInfo.aParents) = -1) ;
                    Move hoParent to oInfo.aParents[-1]
            Loop
            Move oInfo to aInfo[-1]
        Loop

        // Build reverse links from the completed parent snapshot. This avoids
        // exposure-order-dependent incremental updates.
        For iIndex from 0 to (SizeOfArray(aInfo) - 1)
            For iParent from 0 to (SizeOfArray(aInfo[iIndex].aParents) - 1)
                Move aInfo[iIndex].aParents[iParent] to hoParent
                Move (SearchArray(hoParent, aExposedDDs)) to iParentIndex
                If (iParentIndex <> -1 and ;
                    SearchArray(aInfo[iIndex].hoDD, aInfo[iParentIndex].aChilds) = -1) ;
                    Move aInfo[iIndex].hoDD to aInfo[iParentIndex].aChilds[-1]
            Loop
        Loop

        Set paFileInfo to aInfo
    End_Procedure

    Function IsObjectValidDataDictionary Handle hoDD Returns Boolean
        Handle hEntity

        If (IsObjectOfClass(hoDD, (RefClass(cDataDictionary))) = False) ;
            Function_Return False

        Get Main_File of hoDD to hEntity
        Function_Return (hEntity <> 0 and hEntity <> C_UnresolvedObject)
    End_Function

    Function NameOfDD Handle hoDD Returns String
        String sName

        Get TableDbName of hoDD to sName
        Function_Return sName
    End_Function

    Function LoweredNameOfDD Handle hoDD Returns String
        Function_Return (Lowercase(NameOfDD(Self, hoDD)))
    End_Function

    Function IsDDRelated Handle hoDD Handle hoTest Boolean ByRef bOptParent Returns Boolean
        Integer iIndex
        Handle[] aExposedDDs
        tDDPCrossPlatformFileInfo[] aInfo

        If (num_arguments > 2) Move False to bOptParent
        If (hoDD = 0 or hoTest = 0) Function_Return False

        Get paExposedDDs to aExposedDDs
        Move (SearchArray(hoDD, aExposedDDs)) to iIndex
        If (iIndex = -1) Begin
            Error DFERR_PROGRAM "Non-exposed DD"
            Function_Return False
        End

        Get paFileInfo to aInfo
        If (iIndex >= SizeOfArray(aInfo)) Function_Return False

        If (SearchArray(hoTest, aInfo[iIndex].aParents) <> -1) Begin
            If (num_arguments > 2) Move True to bOptParent
            Function_Return True
        End

        If (SearchArray(hoTest, aInfo[iIndex].aChilds) <> -1) Begin
            If (num_arguments > 2) Move False to bOptParent
            Function_Return True
        End

        Function_Return False
    End_Function


    { MethodType = Event }
    Procedure OnExposeDD tDDPDataDictPair Def
    End_Procedure

    Function DFTypeToJson Integer eType Integer iPrecision Returns Integer
        If (eType = C_TypeNumber) Begin
            If (iPrecision > 0) Function_Return jsonTypeDouble
            Function_Return jsonTypeInteger
        End

        If (eType = C_TypeBoolean or eType = C_TypeBit) ;
            Function_Return jsonTypeBoolean

        If (eType = C_TypeReal or eType = C_TypeFloat or ;
            eType = C_TypeCurrency or eType = C_TypeDecimal) ;
            Function_Return jsonTypeDouble

        If (eType = C_TypeLongPtr or eType = C_TypeBigint or ;
            eType = C_TypeShort or eType = C_TypeUShort or ;
            eType = C_TypeULong or eType = C_TypeBiguint or ;
            eType = C_TypeInteger) ;
            Function_Return jsonTypeInteger

        If (eType = C_TypeNone) Function_Return jsonTypeNull
        Function_Return jsonTypeString
    End_Function

    // Selects fields for JSON output.
    Function DDPSerializedFields tDDPTableQuery query Boolean bForceRelated Returns Integer[]
        Integer[] aFields
        Integer iField iFieldCount iParent iRelatedField
        Boolean bRelated

        If (SizeOfArray(query.aFields) > 0) Begin
            Move query.aFields to aFields
        End
        Else Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Move False to bRelated
                For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                    Get FieldRelation query.hoDD query.aParents[iParent].hoDD iField (&iRelatedField) to bRelated
                    If (bRelated) Break
                Loop
                If (not(bRelated)) Move iField to aFields[-1]
            Loop
        End

        If (bForceRelated) Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Move False to bRelated
                For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                    Get FieldRelation query.hoDD query.aParents[iParent].hoDD iField (&iRelatedField) to bRelated
                    If (bRelated) Break
                Loop
                If (not(bRelated) and query.hoParentDD <> 0) ;
                    Get FieldRelation query.hoDD query.hoParentDD iField (&iRelatedField) to bRelated
                If (bRelated) Move iField to aFields[-1]
            Loop
        End

        Function_Return aFields
    End_Function

    // Serializes one typed field value.
    Procedure SerializeFieldValue Handle hoJson Handle hoDD Integer iField Variant vValue
        Integer eType iPrecision
        String sName sValue
        Date dValue
        DateTime dtValue
        Time tValue

        Get FieldName hoDD iField to sName
        Get FieldType hoDD iField to eType
        Get FieldPrecision hoDD iField to iPrecision
        If (eType = C_TypeDate) Begin
            Move vValue to dValue
            Move dValue to sValue
            If (sValue = "0") Move "" to sValue
            Send SetMemberValue of hoJson sName (DFTypeToJson(Self, eType, iPrecision)) sValue
        End
        Else If (eType = C_TypeDateTime) Begin
            Move vValue to dtValue
            Move dtValue to sValue
            If (sValue = "0") Move "" to sValue
            Send SetMemberValue of hoJson sName (DFTypeToJson(Self, eType, iPrecision)) sValue
        End
        Else If (eType = C_TypeTime) Begin
            Move vValue to tValue
            Move tValue to sValue
            Send SetMemberValue of hoJson sName (DFTypeToJson(Self, eType, iPrecision)) sValue
        End
        Else ;
            Send SetMemberValue of hoJson sName (DFTypeToJson(Self, eType, iPrecision)) vValue
    End_Procedure

    Procedure SerializeBufferToJson Handle hoJson tDDPTableQuery query Boolean bForceRelated
        Integer[] aFields
        Integer iIndex
        Variant vValue

        Get DDPSerializedFields query bForceRelated to aFields
        For iIndex from 0 to (SizeOfArray(aFields) - 1)
            Get Entity_Field_Value of query.hoDD (aFields[iIndex] - 1) to vValue
            Send SerializeFieldValue hoJson query.hoDD aFields[iIndex] vValue
        Loop
    End_Procedure

    Procedure StoreDDFileLayout Handle hoDD
        Handle[] aExposedDDs

        If (hoDD = 0) Procedure_Return
        Get paExposedDDs to aExposedDDs
        If (SearchArray(hoDD, aExposedDDs) = -1) ;
            Move hoDD to aExposedDDs[-1]
        Set paExposedDDs to aExposedDDs

        // Rebuild complete snapshot from native parent metadata. Reverse
        // links are derived after all known DDs are collected, so exposure
        // order cannot corrupt the cache.
        Send RebuildDDFileLayout
    End_Procedure

    Function DDParents Handle hoDD Returns Handle[]
        Integer iIndex iParent
        Handle[] aExposedDDs aHandles
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Function_Return aHandles
        Get paExposedDDs to aExposedDDs
        Move (SearchArray(hoDD, aExposedDDs)) to iIndex
        If (iIndex <> -1) Begin
            Get paFileInfo to aInfo
            For iParent from 0 to (SizeOfArray(aInfo[iIndex].aParents) - 1)
                Move aInfo[iIndex].aParents[iParent] to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function

    Function DDChilds Handle hoDD Returns Handle[]
        Integer iIndex iChild
        Handle[] aExposedDDs aHandles
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Function_Return aHandles
        Get paExposedDDs to aExposedDDs
        Move (SearchArray(hoDD, aExposedDDs)) to iIndex
        If (iIndex <> -1) Begin
            Get paFileInfo to aInfo
            For iChild from 0 to (SizeOfArray(aInfo[iIndex].aChilds) - 1)
                Move aInfo[iIndex].aChilds[iChild] to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function


    Function PrimaryDDIndex Handle hoDD Returns Integer
        Integer iIndexCount

        If (hoDD = 0) Function_Return 0
        Get Entity_Index_Count of hoDD to iIndexCount
        If (iIndexCount > 0) Function_Return 1
        Function_Return 0
    End_Function

    // Returns native primary-key fields.
    Function DDPPrimaryKeyFields Handle hoDD Returns Integer[]
        Integer iField
        DbField[] aPKFields
        Integer[] aFields

        If (hoDD = 0) Function_Return aFields
        Get TablePrimaryKeyFields of hoDD to aPKFields
        For iField from 0 to (SizeOfArray(aPKFields) - 1)
            Move (aPKFields[iField] + 1) to aFields[-1]
        Loop

        Function_Return aFields
    End_Function

    Function FieldCount Handle hoDD Returns Integer
        Integer iFieldCount

        If (hoDD = 0) Function_Return 0
        Get TableFieldCount of hoDD to iFieldCount
        Function_Return iFieldCount
    End_Function

    Function FieldName Handle hoDD Integer iField Returns String
        Integer iFieldCount iEntityField
        String sFieldName

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return ""
        Get FieldName of hoDD iEntityField to sFieldName
        Function_Return sFieldName
    End_Function

    Function FieldType Handle hoDD Integer iField Returns Integer
        Integer iFieldCount iEntityField eType

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return C_TypeNone
        Get FieldType of hoDD iEntityField to eType
        Function_Return eType
    End_Function

    Function FieldPrecision Handle hoDD Integer iField Returns Integer
        Integer iFieldCount iEntityField iPrecision

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return 0
        Get FieldPrecision of hoDD iEntityField to iPrecision
        Function_Return iPrecision
    End_Function


    // Finds the parent field related to iField on hoDD.
    Function FieldRelation Handle hoDD Handle hoParentDD Integer iField Integer ByRef iRelatedField Returns Boolean
        Handle hParentEntity
        Integer iParent iFieldIndex iEntityField
        Boolean bRelated
        tDDParent[] aParents

        Move 0 to iRelatedField
        If (hoDD = 0 or hoParentDD = 0 or hoDD = hoParentDD) ;
            Function_Return False

        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= FieldCount(Self, hoDD)) ;
            Function_Return False

        Get phEntity of hoParentDD to hParentEntity
        Get paParents of hoDD to aParents
        For iParent from 0 to (SizeOfArray(aParents) - 1)
            If (aParents[iParent].hEntity = hParentEntity) Begin
                For iFieldIndex from 0 to (SizeOfArray(aParents[iParent].rel.aForeignKey) - 1)
                    If (aParents[iParent].rel.aForeignKey[iFieldIndex] = iEntityField) Begin
                        Move (aParents[iParent].rel.aRelatedKey[iFieldIndex] + 1) to iRelatedField
                        Move True to bRelated
                        Function_Return bRelated
                    End
                Loop
            End
        Loop

        Function_Return False
    End_Function

    // Converts a backend field type and precision to the DDP schema type.
    Function DDPTypeString Integer eType Integer iPrecision Returns String
        If (eType = C_TypeDate) Function_Return "date"

        If (eType = C_TypeNumber) Begin
            If (iPrecision > 0) Function_Return "decimal"
            Function_Return "integer"
        End

        If (eType = C_TypeReal or eType = C_TypeFloat or ;
            eType = C_TypeCurrency or eType = C_TypeDecimal) ;
            Function_Return "decimal"

        If (eType = C_TypeLongPtr or eType = C_TypeBigint or ;
            eType = C_TypeShort or eType = C_TypeUShort or ;
            eType = C_TypeULong or eType = C_TypeBiguint or ;
            eType = C_TypeInteger) ;
            Function_Return "integer"

        Function_Return "string"
    End_Function


    Function IsField Handle hoDD String sFieldName Integer ByRef iOptField Returns Boolean
        Integer iField iFieldCount
        String sField

        If (hoDD = 0) Function_Return False
        Get FieldCount hoDD to iFieldCount
        For iField from 1 to iFieldCount
            Get FieldName hoDD iField to sField
            If (Lowercase(sField) = Lowercase(sFieldName)) Begin
                If (num_arguments > 2) Move iField to iOptField
                Function_Return True
            End
        Loop

        Function_Return False
    End_Function


    Function AddConstrain Handle hoMainDD Handle hoDD Handle hField Integer eConstrain String sFilter Returns tDDPBuilderResult
        Integer eDbConstrain iField iFieldCount eType
        Date dValue
        tDDPBuilderResult oResult

        If (hoDD = 0) Begin
            Move DDPERR_INVALID_FIELD to oResult.iErr
            Move "Invalid constrain field." to oResult.sError
            Function_Return oResult
        End

        Get FieldCount hoDD to iFieldCount
        Move (hField - 1) to iField
        If (iField < 0 or iField >= iFieldCount) Begin
            Move DDPERR_INVALID_FIELD to oResult.iErr
            Move "Invalid constrain field." to oResult.sError
            Function_Return oResult
        End

        Case Begin
            Case (eConstrain = DDPFind_LT)
                Move C_DbConstraint_LT to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_LE)
                Move C_DbConstraint_LE to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_EQ)
                Move C_DbConstraint_EQ to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_GE)
                Move C_DbConstraint_GE to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_GT)
                Move C_DbConstraint_GT to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_NE)
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Constraint '_ne' is not supported." to oResult.sError
                Function_Return oResult
            Case Else
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Invalid constrain." to oResult.sError
                Function_Return oResult
        Case End

        Get FieldType hoDD hField to eType
        If (eType = C_TypeDate) Begin
            If (not(DDPParseISODate(sFilter, &dValue))) Begin
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Invalid date constraint; expected YYYY-MM-DD." to oResult.sError
                Function_Return oResult
            End
            Send Add_Value_Constraint of hoDD hoMainDD iField eDbConstrain dValue
        End
        Else ;
            Send Add_Value_Constraint of hoDD hoMainDD iField eDbConstrain sFilter
        Function_Return oResult
    End_Function

    // DDP runtime operations for the cross-platform data dictionary API.
    Procedure DDPLink Handle hoDD Handle hoRelated Boolean bClient Boolean bConstrain
        If (hoDD = 0 or hoRelated = 0) Procedure_Return

        Set DDO_Server of hoDD to hoRelated
    End_Procedure

    { Visibility = Private }
    Procedure DDPClearRelationsVisit Handle hoDD Handle[] ByRef aVisited
        Handle[] aChildren
        tDDParent[] aParents
        Integer iIndex

        If (hoDD = 0 or SearchArray(hoDD, aVisited) <> -1) Procedure_Return
        Move hoDD to aVisited[-1]

        Get paChildren of hoDD to aChildren
        For iIndex from 0 to (SizeOfArray(aChildren) - 1)
            Send DDPClearRelationsVisit aChildren[iIndex] (&aVisited)
        Loop

        Get paParents of hoDD to aParents
        For iIndex from 0 to (SizeOfArray(aParents) - 1)
            If (aParents[iIndex].hoDD <> 0) ;
                Send DDPClearRelationsVisit aParents[iIndex].hoDD (&aVisited)
        Loop

        Send Rebuild_Constraints of hoDD
        Send Clear of hoDD
    End_Procedure

    Procedure DDPClearRelations Handle hoDD Handle hoOptParentDD
        Handle[] aVisited

        If (hoOptParentDD <> 0) Move hoOptParentDD to aVisited[-1]
        Send DDPClearRelationsVisit hoDD (&aVisited)
    End_Procedure
    
    Procedure DDPRequestRead Handle hoDD Integer eMode Handle hFile Integer iIndex
        Integer iFindIndex


        Move iIndex to iFindIndex
        If (iFindIndex = -1 and (eMode = FIRST_RECORD or eMode = NEXT_RECORD)) ;
            Move 1 to iFindIndex
        Send Find of hoDD eMode iFindIndex
    End_Procedure

    Procedure DDPRequestFind Handle hoDD Integer eMode Handle hFile Integer iIndex
        Integer iFindIndex


        Move iIndex to iFindIndex
        If (iFindIndex = -1 and (eMode = FIRST_RECORD or eMode = NEXT_RECORD)) ;
            Move 1 to iFindIndex
        Send Find of hoDD eMode iFindIndex
    End_Procedure

    Procedure DDPSetFieldValue Handle hoDD Handle hFile Integer iField String sValue
        Integer iFieldCount iEntityField

        If (hoDD = 0) Procedure_Return
        Get Entity_Field_Count of hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Procedure_Return
        Set Entity_Field_Value of hoDD iEntityField to sValue
    End_Procedure

    Procedure DDPSetChangedValue Handle hoDD Handle hFile Integer iField String sValue
        Integer iFieldCount iEntityField

        If (hoDD = 0) Procedure_Return
        Get Entity_Field_Count of hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Procedure_Return
        Set Field_Changed_State of hoDD iEntityField to True
        Set Entity_Field_Value of hoDD iEntityField to sValue
    End_Procedure

    Function DDPGetFieldValue Handle hoDD Handle hFile Integer iField Returns String
        Integer iFieldCount iEntityField
        String sValue

        If (hoDD = 0) Function_Return ""
        Get Entity_Field_Count of hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return ""
        Get Entity_Field_Value of hoDD iEntityField to sValue
        Function_Return sValue
    End_Function

    Function DDPCurrentRowID Handle hoDD Handle hFile Returns RowID
        RowID riCurrent

        Move (NullRowID()) to riCurrent
        If (hoDD <> 0) Get CurrentRowID of hoDD to riCurrent
        Function_Return riCurrent
    End_Function

    Function DDPValidateDelete Handle hoDD Returns Boolean
        Function_Return (not(Can_Delete(hoDD)))
    End_Function

    Function DDPErrorText String sFallback Returns String
        Function_Return sFallback
    End_Function

    { Visibility = Private }
    // Finds a table layout by DD.
    Function DDPTableResultLayoutIndex Handle hoDD tDDPTableResultLayout[] aTableLayouts Returns Integer
        Integer iIndex
        For iIndex from 0 to (SizeOfArray(aTableLayouts) - 1)
            If (aTableLayouts[iIndex].hoDD = hoDD) Function_Return iIndex
        Loop
        Function_Return -1
    End_Function

    { Visibility = Private }
    // Collects tables projected in flat output.
    Procedure DDPCollectTableResultLayouts tDDPTableQuery query Handle hoScopeDD tDDPTableResultLayout[] ByRef aTableLayouts
        tDDPTableResultLayout oTableLayout
        Integer iParent iTableLayout
        Get DDPTableResultLayoutIndex query.hoDD aTableLayouts to iTableLayout
        If (iTableLayout = -1) Begin
            Move query.hoDD to oTableLayout.hoDD
            Move oTableLayout to aTableLayouts[-1]
        End

        For iParent from 0 to (SizeOfArray(query.aParents) - 1)
            Send DDPCollectTableResultLayouts query.aParents[iParent] 0 (&aTableLayouts)
        Loop

        Get DDPTableResultLayoutIndex hoScopeDD aTableLayouts to iTableLayout
        If (hoScopeDD <> 0 and iTableLayout = -1) Begin
            Move hoScopeDD to oTableLayout.hoDD
            Move oTableLayout to aTableLayouts[-1]
        End
    End_Procedure

    { Visibility = Private }
    // Rebuilds find constraints recursively.
    Procedure DDPRebuildFindConstraints tDDPTableQuery query
        Integer iIndex

        Send Rebuild_Constraints of query.hoDD
        For iIndex from 0 to (SizeOfArray(query.aParents) - 1)
            Send DDPRebuildFindConstraints query.aParents[iIndex]
        Loop
        For iIndex from 0 to (SizeOfArray(query.aChilds) - 1)
            Send DDPRebuildFindConstraints query.aChilds[iIndex]
        Loop
    End_Procedure

    { Visibility = Private }
    // Validates a find query recursively.
    Function DDPValidateFindQuery tDDPTableQuery query Returns tDDPBuilderResult
        Handle hoQuery
        tDDPBuilderResult oResult
        Integer iChild

        Get Create (RefClass(cDbQuery)) to hoQuery
        If (hoQuery = 0) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End

        Set Server of hoQuery to query.hoDD
        Get AddConstrainsToCurrentSet hoQuery query to oResult
        Send Destroy of hoQuery
        If (oResult.iErr) Function_Return oResult

        For iChild from 0 to (SizeOfArray(query.aChilds) - 1)
            Get DDPValidateFindQuery query.aChilds[iChild] to oResult
            If (oResult.iErr) Function_Return oResult
        Loop

        Function_Return oResult
    End_Function

    // Prepares and validates a native find.
    Function DDPPrepareFind tDDPTableQuery query Returns tDDPBuilderResult
        tDDPBuilderResult oResult

        Get QueryLinkUp query to oResult

        Send DDPRebuildFindConstraints query
        Get DDPValidateFindQuery query to oResult
        Function_Return oResult
    End_Function

    { Visibility = Private }
    // Configures the native query.
    Function DDPConfigureQuery tDDPTableQuery query tDDPFindRecord scope Handle hoQuery tDDPTableResultLayout[] ByRef aTableLayouts Returns tDDPBuilderResult
        Handle hoSet hoAdapter
        tDDPBuilderResult oResult
        Integer iIndex iTableLayout iField iFieldCount iDataCol
        tDbRelation relation
        tDbConstraint[] aConstraints
        Integer[] aDDPPKFields aScopePKFields
        String sPKField
        Boolean bHasRowId
        tDbOperationDetails operationDetails
        tDDPTableResultLayout oTableLayout

        Set phoServer of hoQuery to query.hoDD
        Get AddConstrainsToCurrentSet hoQuery query to oResult
        If (oResult.iErr) Function_Return oResult

        Get ConstraintSet of hoQuery to hoSet
        If (hoSet = 0 or hoSet = C_UnresolvedObject) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End

        If (scope.hoDD <> 0) Begin
            Get RelationByTable of query.hoDD scope.hoDD to relation
            If (relation.hMainTable <> query.hoDD) Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "Find failed." to oResult.sError
                Function_Return oResult
            End

            Get DDPPrimaryKeyFields scope.hoDD to aScopePKFields
            If (SizeOfArray(aScopePKFields) = 0) Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "Find failed." to oResult.sError
                Function_Return oResult
            End

            Get ActiveConstraints of hoSet to aConstraints
            Move False to bHasRowId
            For iIndex from 0 to (SizeOfArray(aConstraints) - 1)
                If (aConstraints[iIndex].eType = C_DbConstraint_RowId) Move True to bHasRowId
            Loop
            If (bHasRowId) Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "Find failed." to oResult.sError
                Function_Return oResult
            End
            Send Add_Value_Constraint of hoSet scope.hoDD 0 C_DbConstraint_RowId scope.riRowId
        End

        Send DDPCollectTableResultLayouts query scope.hoDD (&aTableLayouts)
        Move query.hoDD to operationDetails.hMainTable
        Move False to Err
        Send RegisterConstraints of hoSet (&operationDetails)
        If (Err) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End
        Move False to Err
        Send DetermineConstraints of query.hoDD (&operationDetails)
        If (Err) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End
        For iIndex from 0 to (SizeOfArray(operationDetails.aConstraints) - 1)
            Move operationDetails.aConstraints[iIndex].hTable to oTableLayout.hoDD
            If (oTableLayout.hoDD <> 0 and oTableLayout.hoDD <> query.hoDD) Begin
                Get DDPTableResultLayoutIndex oTableLayout.hoDD aTableLayouts to iTableLayout
                If (iTableLayout = -1) Move oTableLayout to aTableLayouts[-1]
            End
        Loop

        Get DDPPrimaryKeyFields query.hoDD to aDDPPKFields
        If (SizeOfArray(aDDPPKFields) = 0) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End
        Move 0 to iDataCol

        Get Adapter of query.hoDD to hoAdapter
        If (hoAdapter = 0 or hoAdapter = C_UnresolvedObject) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End
        For iIndex from 0 to (SizeOfArray(aTableLayouts) - 1)
            Move iDataCol to aTableLayouts[iIndex].iDataColumnStart
            Get FieldCount aTableLayouts[iIndex].hoDD to iFieldCount
            Get DDPPrimaryKeyFields aTableLayouts[iIndex].hoDD to aDDPPKFields
            If (SizeOfArray(aDDPPKFields) = 0) Begin
                Move DDPERR_FIND_FAILED to oResult.iErr
                Get DDPErrorText "Find failed." to oResult.sError
                Function_Return oResult
            End

            For iField from 1 to iFieldCount
                Send Bind_Data of hoQuery aTableLayouts[iIndex].hoDD (iField - 1)
                Increment iDataCol
            Loop

            Get SQLFieldName of hoAdapter query.hoDD aTableLayouts[iIndex].hoDD ;
                aDDPPKFields[0] to sPKField
            Send Bind_Native_Expression of hoQuery ;
                ("CASE WHEN " + sPKField + " IS NULL THEN 0 ELSE 1 END") aTableLayouts[iIndex].hoDD
            Move iDataCol to aTableLayouts[iIndex].iPresenceColumn
            Increment iDataCol
        Loop

        For iIndex from 0 to (SizeOfArray(query.aOrder) - 1)
            Send OrderByField of hoQuery query.hoDD ;
                (query.aOrder[iIndex].hField - 1) query.aOrder[iIndex].eMode
        Loop
        Function_Return oResult
    End_Function

    { Visibility = Private }
    // Builds one typed table snapshot.
    Procedure DDPBuildTableSnapshot Handle hoAdapter Handle hoRootDD tDDPTableResultLayout tableLayout Variant[] aRow RowID riRoot tDDPFindRecord ByRef record
        tDbTableData data
        Integer iResultCol

        Move tableLayout.hoDD to record.hoDD
        Move False to record.bPresent
        If (aRow[tableLayout.iPresenceColumn] = 0) Begin
            Get CreateBuffer of tableLayout.hoDD to record.vData
            Procedure_Return
        End
        Move tableLayout.iDataColumnStart to iResultCol
        Get FetchTable of hoAdapter tableLayout.hoDD aRow (&iResultCol) tableLayout.hoDD to data
        Move data.rRowId to record.riRowId
        If (tableLayout.hoDD = hoRootDD) Move riRoot to record.riRowId
        Move True to record.bPresent
        Move data.vData to record.vData
    End_Procedure

    { Visibility = Private }
    // Builds a snapshot tree from one row.
    Procedure DDPBuildRecordFromNode Handle hoAdapter Handle hoRootDD tDDPTableQuery query tDDPTableResultLayout[] aTableLayouts Variant[] aRow RowID riRoot tDDPFindRecord ByRef record
        Integer iTableLayout iParent
        tDDPFindRecord emptyRecord

        Move emptyRecord to record
        Get DDPTableResultLayoutIndex query.hoDD aTableLayouts to iTableLayout
        If (iTableLayout <> -1) Begin
            Send DDPBuildTableSnapshot hoAdapter hoRootDD aTableLayouts[iTableLayout] aRow riRoot (&record)
        End
        For iParent from 0 to (SizeOfArray(query.aParents) - 1)
            Send DDPBuildRecordFromNode hoAdapter hoRootDD query.aParents[iParent] aTableLayouts ;
                aRow riRoot (&record.aParents[iParent])
        Loop
    End_Procedure

    // Fetches records into snapshots.
    Function DDPFetchRecords tDDPTableQuery query Integer eStyle tDDPFindRecord scope tDDPFindRecord[] ByRef aRecords Returns tDDPBuilderResult
        Handle hoQuery hoAdapter
        tDDPBuilderResult oResult
        tDDPTableResultLayout[] aTableLayouts
        tDDPFindRecord[] aResult aChildRecords aEmptyRecords
        tDDPFindRecord record childScope
        tDDPTableQuery childQuery
        tDDPTableQuery[] aEmptyChildQueries
        Variant[][] aData
        DbRowId[] aRowIds
        Integer iFetchLimit iRow iRowCount iOutputCount iChild iChildStyle
        BigInt biFetchLimit biMaxInteger
        If (scope.hoDD <> 0 and not(scope.bPresent)) Function_Return oResult

        Move aEmptyRecords to aRecords
        Move aEmptyRecords to aResult

        Get Create (RefClass(cDbQuery)) to hoQuery
        If (hoQuery = 0) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Function_Return oResult
        End

        Get Adapter of query.hoDD to hoAdapter
        If (hoAdapter = 0 or hoAdapter = C_UnresolvedObject) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Send Destroy of hoQuery
            Function_Return oResult
        End

        Get DDPConfigureQuery query scope hoQuery (&aTableLayouts) to oResult
        If (oResult.iErr) Begin
            Send Destroy of hoQuery
            Function_Return oResult
        End

        Move 0 to iFetchLimit
        If (query.iLimit > 0) Begin
            Move query.iLimit to biFetchLimit
            Move (biFetchLimit + query.iOffset) to biFetchLimit
            Move 2147483647 to biMaxInteger
            If (biFetchLimit <= biMaxInteger) Move biFetchLimit to iFetchLimit
        End

        Move False to Err
        Get FetchFirst of hoQuery iFetchLimit (&aRowIds) to aData
        If (Err or SizeOfArray(aData) <> SizeOfArray(aRowIds)) Begin
            Move DDPERR_FIND_FAILED to oResult.iErr
            Get DDPErrorText "Find failed." to oResult.sError
            Send Destroy of hoQuery
            Function_Return oResult
        End
        Move query.iOffset to iRow
        Move 0 to iOutputCount
        Move (SizeOfArray(aData)) to iRowCount
        While (iRow < iRowCount and (query.iLimit = 0 or iOutputCount < query.iLimit))

            Send DDPBuildRecordFromNode hoAdapter query.hoDD query aTableLayouts ;
                aData[iRow] aRowIds[iRow] (&record)

            For iChild from 0 to (SizeOfArray(query.aChilds) - 1)
                Move record.hoDD to childScope.hoDD
                Move record.riRowId to childScope.riRowId
                Move record.bPresent to childScope.bPresent
                Move query.aChilds[iChild] to childQuery
                Move eStyle to iChildStyle
                If (eStyle = DDPStyle_FlatLinked) Begin
                    Move 0 to childQuery.iLimit
                    Move 0 to childQuery.iOffset
                    Move aEmptyChildQueries to childQuery.aChilds
                    Move DDPStyle_Nested to iChildStyle
                End
                Get DDPFetchRecords childQuery iChildStyle childScope (&aChildRecords) to oResult
                If (oResult.iErr) Begin
                    Send Destroy of hoQuery
                    Function_Return oResult
                End
                Move aChildRecords to record.aaChilds[iChild]
            Loop

            Move record to aResult[-1]
            Increment iOutputCount
            Increment iRow
        Loop

        Send Destroy of hoQuery
        Move aResult to aRecords
        Function_Return oResult
    End_Function

    // Serializes one present snapshot.
    Procedure DDPSerializeRecordToJson Handle hoJson tDDPTableQuery query tDDPFindRecord record Boolean bForceRelated
        Integer[] aFields
        Integer iIndex
        Variant vValue

        If (not(record.bPresent)) Procedure_Return

        Get DDPSerializedFields query bForceRelated to aFields
        For iIndex from 0 to (SizeOfArray(aFields) - 1)
            Get StructMember (&record.vData) (aFields[iIndex] - 1) to vValue
            Send SerializeFieldValue hoJson query.hoDD aFields[iIndex] vValue
        Loop
    End_Procedure
End_Class
