Use WebApi\DDP\Backends\IBackend.pkg
Use Db\cDataDictionary.pkg
Use Db\cDbQuery.pkg


Function DDPParseISODate Global String sValue Date ByRef dValue Returns Boolean
    Integer iPosition iYear iMonth iDay
    String sCharacter

    If (Length(sValue) <> 10 or Mid(sValue, 1, 5) <> "-" or Mid(sValue, 1, 8) <> "-") ;
        Function_Return False

    For iPosition from 1 to 10
        If (iPosition <> 5 and iPosition <> 8) Begin
            Move (Mid(sValue, 1, iPosition)) to sCharacter
            If (Pos(sCharacter, "0123456789") = 0) Function_Return False
        End
    Loop

    Move (Left(sValue, 4)) to iYear
    Move (Mid(sValue, 2, 6)) to iMonth
    Move (Right(sValue, 2)) to iDay
    Try
        Move (DateSet(iYear, iMonth, iDay)) to dValue
    Catch
        Function_Return False
    End_Try

    Function_Return True
End_Function

Struct tDDPCrossPlatformFileInfo
    Handle hoDD
    Handle[] aParents
    Handle[] aChilds
End_Struct

Class cDDPNativeOrderedIndex is a cObject
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Handle phoDD C_UnresolvedObject
        Property tDDPOrder[] paOrder
        Property tDDPConstrain[] paConstrains
        Property RowID[] paRowIDs
        Property Integer piPosition -1
        Property Integer piRowCount 0
        Property Integer piFetchLimit 0
    End_Procedure

    Procedure Configure Handle hoDD tDDPOrder[] aOrder tDDPConstrain[] aConstrains Integer iLimit Integer iOffset
        RowID[] aEmpty

        Set phoDD to hoDD
        Set paOrder to aOrder
        Set paConstrains to aConstrains
        Set paRowIDs to aEmpty
        Set piPosition to -1
        Set piRowCount to 0
        If (iLimit = 0) ;
            Set piFetchLimit to 0
        Else ;
            Set piFetchLimit to (iLimit + iOffset)
    End_Procedure

    { Visibility = Private }
    Procedure AddValueConstraints Handle hoQuery Handle hoDD
        Handle hoSet
        Integer iConstrain eConstrain eDbConstrain eType
        Date dValue
        String sFilter
        tDDPConstrain[] aConstrains

        Get paConstrains to aConstrains
        Get ConstraintSet of hoQuery to hoSet
        For iConstrain from 0 to (SizeOfArray(aConstrains) - 1)
            If (aConstrains[iConstrain].eMode <> DDPFind_NE) Begin
                Move aConstrains[iConstrain].eMode to eConstrain
                Case Begin
                    Case (eConstrain = DDPFind_LT)
                        Move C_DbConstraint_LT to eDbConstrain
                        Case Break
                    Case (eConstrain = DDPFind_LE)
                        Move C_DbConstraint_LE to eDbConstrain
                        Case Break
                    Case (eConstrain = DDPFind_EQ)
                        Move C_DbConstraint_EQ to eDbConstrain
                        Case Break
                    Case (eConstrain = DDPFind_GE)
                        Move C_DbConstraint_GE to eDbConstrain
                        Case Break
                    Case (eConstrain = DDPFind_GT)
                        Move C_DbConstraint_GT to eDbConstrain
                        Case Break
                Case End

                Get FieldType of hoDD (aConstrains[iConstrain].hField - 1) to eType
                Move aConstrains[iConstrain].aParams[0] to sFilter
                If (eType = C_TypeDate) Begin
                    If (not(DDPParseISODate(sFilter, &dValue))) Procedure_Return
                    Send Add_Value_Constraint of hoSet hoDD ;
                        (aConstrains[iConstrain].hField - 1) eDbConstrain dValue
                End
                Else ;
                    Send Add_Value_Constraint of hoSet hoDD ;
                        (aConstrains[iConstrain].hField - 1) eDbConstrain sFilter
            End
        Loop
    End_Procedure

    Procedure ReadRecord Integer eMode
        Handle hoDD hoQuery
        Integer iOrder iPosition iLimit iRowCount
        Boolean bHasRecord
        tDDPOrder[] aOrder
        RowID[] aRowIDs
        Variant[][] aIgnored

        Get phoDD to hoDD
        Get paOrder to aOrder
        If (eMode <> NEXT_RECORD) Begin
            Get piFetchLimit to iLimit
            Get Create (RefClass(cDbQuery)) to hoQuery
            Set Server of hoQuery to hoDD
            Send AddValueConstraints hoQuery hoDD
            For iOrder from 0 to (SizeOfArray(aOrder) - 1)
                Send OrderByField of hoQuery hoDD (aOrder[iOrder].hField - 1) aOrder[iOrder].eMode
            Loop
            Get FetchFirst of hoQuery iLimit (&aRowIDs) to aIgnored
            Send Destroy of hoQuery
            Set piRowCount to (SizeOfArray(aIgnored))
            Set paRowIDs to aRowIDs
            Move 0 to iPosition
        End
        Else Begin
            Get paRowIDs to aRowIDs
            Get piPosition to iPosition
            Increment iPosition
        End
        Get piRowCount to iRowCount

        If (iPosition >= 0 and iPosition < iRowCount) Begin
            Send FindByRowId of hoDD aRowIDs[iPosition]
            Get HasRecord of hoDD to bHasRecord
            If (bHasRecord) Begin
                Set piPosition to iPosition
                Procedure_Return
            End
        End
        Set piPosition to iPosition
        Move False to Found
        Send Clear of hoDD
    End_Procedure
End_Class


Class cDDP_Backend_Mixin is a IDDP_Backend_Mixin
    Procedure Define_DDP_Backend_Mixin
        Property Handle[] paExposedDDs
        Property tDDPCrossPlatformFileInfo[] paFileInfo


    End_Procedure

    Procedure End_Define_DDP_Backend_Mixin
    End_Procedure

    { Visibility = Private }
    Function ExposedDDByEntity Handle hEntity Handle[] aExposedDDs Returns Handle
        Integer iIndex
        Handle hDDEntity

        If (hEntity = 0) Function_Return 0
        For iIndex from 0 to (SizeOfArray(aExposedDDs) - 1)
            Get phEntity of aExposedDDs[iIndex] to hDDEntity
            If (hDDEntity = hEntity) Function_Return aExposedDDs[iIndex]
        Loop

        Function_Return 0
    End_Function

    { Visibility = Private }
    Procedure RebuildDDFileLayout
        Integer iIndex iParent iParentIndex
        Handle hoParent
        Handle[] aExposedDDs aEmpty
        tDDParent[] aDDParents
        tDDPCrossPlatformFileInfo oInfo
        tDDPCrossPlatformFileInfo[] aInfo

        Get paExposedDDs to aExposedDDs
        For iIndex from 0 to (SizeOfArray(aExposedDDs) - 1)
            Move 0 to oInfo.hoDD
            Move aEmpty to oInfo.aParents
            Move aEmpty to oInfo.aChilds
            Move aExposedDDs[iIndex] to oInfo.hoDD

            Get paParents of aExposedDDs[iIndex] to aDDParents
            For iParent from 0 to (SizeOfArray(aDDParents) - 1)
                Get ExposedDDByEntity aDDParents[iParent].hEntity aExposedDDs to hoParent
                If (hoParent <> 0 and SearchArray(hoParent, oInfo.aParents) = -1) ;
                    Move hoParent to oInfo.aParents[-1]
            Loop
            Move oInfo to aInfo[-1]
        Loop

        // Build reverse links from the completed parent snapshot. This avoids
        // exposure-order-dependent incremental updates.
        For iIndex from 0 to (SizeOfArray(aInfo) - 1)
            For iParent from 0 to (SizeOfArray(aInfo[iIndex].aParents) - 1)
                Move aInfo[iIndex].aParents[iParent] to hoParent
                Move (SearchArray(hoParent, aExposedDDs)) to iParentIndex
                If (iParentIndex <> -1 and ;
                    SearchArray(aInfo[iIndex].hoDD, aInfo[iParentIndex].aChilds) = -1) ;
                    Move aInfo[iIndex].hoDD to aInfo[iParentIndex].aChilds[-1]
            Loop
        Loop

        Set paFileInfo to aInfo
    End_Procedure



    Function IsObjectValidDataDictionary Handle hoDD Returns Boolean
        Handle hEntity

        If (IsObjectOfClass(hoDD, (RefClass(cDataDictionary))) = False) ;
            Function_Return False

        Get Main_File of hoDD to hEntity
        Function_Return (hEntity <> 0 and hEntity <> C_UnresolvedObject)
    End_Function

    Function NameOfDD Handle hoDD Returns String
        String sName

        Get TableDbName of hoDD to sName
        Function_Return sName
    End_Function

    Function LoweredNameOfDD Handle hoDD Returns String
        Function_Return (Lowercase(NameOfDD(Self, hoDD)))
    End_Function


    Function IsDDRelated Handle hoDD Handle hoTest Boolean ByRef bOptParent Returns Boolean
        Integer iIndex
        Handle[] aExposedDDs
        tDDPCrossPlatformFileInfo[] aInfo

        If (num_arguments > 2) Move False to bOptParent
        If (hoDD = 0 or hoTest = 0) Function_Return False

        Get paExposedDDs to aExposedDDs
        Move (SearchArray(hoDD, aExposedDDs)) to iIndex
        If (iIndex = -1) Begin
            Error DFERR_PROGRAM "Non-exposed DD"
            Function_Return False
        End

        Get paFileInfo to aInfo
        If (iIndex >= SizeOfArray(aInfo)) Function_Return False

        If (SearchArray(hoTest, aInfo[iIndex].aParents) <> -1) Begin
            If (num_arguments > 2) Move True to bOptParent
            Function_Return True
        End

        If (SearchArray(hoTest, aInfo[iIndex].aChilds) <> -1) Begin
            If (num_arguments > 2) Move False to bOptParent
            Function_Return True
        End

        Function_Return False
    End_Function


    { MethodType = Event }
    Procedure OnExposeDD tDDPDataDictPair Def
    End_Procedure

    Function DFTypeToJson Integer eType Integer iPrecision Returns Integer
        If (eType = C_TypeNumber) Begin
            If (iPrecision > 0) Function_Return jsonTypeDouble
            Function_Return jsonTypeInteger
        End

        If (eType = C_TypeBoolean or eType = C_TypeBit) ;
            Function_Return jsonTypeBoolean

        If (eType = C_TypeReal or eType = C_TypeFloat or ;
            eType = C_TypeCurrency or eType = C_TypeDecimal) ;
            Function_Return jsonTypeDouble

        If (eType = C_TypeLongPtr or eType = C_TypeBigint or ;
            eType = C_TypeShort or eType = C_TypeUShort or ;
            eType = C_TypeULong or eType = C_TypeBiguint or ;
            eType = C_TypeInteger) ;
            Function_Return jsonTypeInteger

        If (eType = C_TypeNone) Function_Return jsonTypeNull
        Function_Return jsonTypeString
    End_Function

    Procedure SerializeField Handle hoJson tDDPTableQuery query Handle iFile Integer iField Boolean bForceField
        Integer iParent iRelatedField eType iPrecision iEntityField
        Boolean bRelated
        String sName
        Variant vValue

        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= FieldCount(Self, query.hoDD)) ;
            Procedure_Return

        If (not(bForceField)) Begin
            For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                Get FieldRelation query.hoDD query.aParents[iParent].hoDD iField (&iRelatedField) to bRelated
                If (bRelated) Procedure_Return
            Loop
        End

        Get FieldName query.hoDD iField to sName
        Get FieldType query.hoDD iField to eType
        Get FieldPrecision query.hoDD iField to iPrecision
        Get Entity_Field_Value of query.hoDD iEntityField to vValue
        Send SetMemberValue of hoJson sName (DFTypeToJson(Self, eType, iPrecision)) vValue
    End_Procedure

    Procedure SerializeBufferToJson Handle hoJson tDDPTableQuery query
        Handle hFile
        Integer iField iFieldCount iParent iRelatedField
        Boolean bForceRelated bRelated

        Move False to bForceRelated
        If (num_arguments > 2) Get_Stack_Argument 3 to bForceRelated
        Get Main_File of query.hoDD to hFile

        Move (SizeOfArray(query.aFields)) to iFieldCount
        If (iFieldCount) Begin
            For iField from 0 to (iFieldCount - 1)
                Send SerializeField hoJson query hFile query.aFields[iField] True
            Loop
        End
        Else Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Send SerializeField hoJson query hFile iField False
            Loop
        End

        If (bForceRelated) Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Move False to bRelated
                For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                    Get FieldRelation query.hoDD query.aParents[iParent].hoDD iField (&iRelatedField) to bRelated
                    If (bRelated) Break
                Loop
                If (not(bRelated) and query.hoParentDD <> 0) ;
                    Get FieldRelation query.hoDD query.hoParentDD iField (&iRelatedField) to bRelated
                If (bRelated) Send SerializeField hoJson query hFile iField True
            Loop
        End
    End_Procedure

    Procedure StoreDDFileLayout Handle hoDD
        Handle[] aExposedDDs

        If (hoDD = 0) Procedure_Return
        Get paExposedDDs to aExposedDDs
        If (SearchArray(hoDD, aExposedDDs) = -1) ;
            Move hoDD to aExposedDDs[-1]
        Set paExposedDDs to aExposedDDs

        // Rebuild complete snapshot from native parent metadata. Reverse
        // links are derived after all known DDs are collected, so exposure
        // order cannot corrupt the cache.
        Send RebuildDDFileLayout
    End_Procedure

    Function DDParents Handle hoDD Returns Handle[]
        Integer iIndex iParent
        Handle[] aExposedDDs aHandles
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Function_Return aHandles
        Get paExposedDDs to aExposedDDs
        Move (SearchArray(hoDD, aExposedDDs)) to iIndex
        If (iIndex <> -1) Begin
            Get paFileInfo to aInfo
            For iParent from 0 to (SizeOfArray(aInfo[iIndex].aParents) - 1)
                Move aInfo[iIndex].aParents[iParent] to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function

    Function DDChilds Handle hoDD Returns Handle[]
        Integer iIndex iChild
        Handle[] aExposedDDs aHandles
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Function_Return aHandles
        Get paExposedDDs to aExposedDDs
        Move (SearchArray(hoDD, aExposedDDs)) to iIndex
        If (iIndex <> -1) Begin
            Get paFileInfo to aInfo
            For iChild from 0 to (SizeOfArray(aInfo[iIndex].aChilds) - 1)
                Move aInfo[iIndex].aChilds[iChild] to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function


    Function DDPPrimaryKeyFields Handle hoDD Returns Integer[]
        Integer iField
        DbField[] aEntityFields
        Integer[] aFields

        If (hoDD = 0) Function_Return aFields
        Get TablePrimaryKeyFields of hoDD to aEntityFields
        For iField from 0 to (SizeOfArray(aEntityFields) - 1)
            Move (aEntityFields[iField] + 1) to aFields[-1]
        Loop

        Function_Return aFields
    End_Function

    Function PrimaryDDIndex Handle hoDD Returns Integer
        Integer iIndexCount
        Integer[] aPKFields

        If (hoDD = 0) Function_Return 0
        Get DDPPrimaryKeyFields hoDD to aPKFields
        If (SizeOfArray(aPKFields) > 0) Function_Return -1

        Get Entity_Index_Count of hoDD to iIndexCount
        If (iIndexCount > 0) Function_Return 1
        Function_Return 0
    End_Function

    Function FieldCount Handle hoDD Returns Integer
        Integer iFieldCount

        If (hoDD = 0) Function_Return 0
        Get TableFieldCount of hoDD to iFieldCount
        Function_Return iFieldCount
    End_Function

    Function FieldName Handle hoDD Integer iField Returns String
        Integer iFieldCount iEntityField
        String sFieldName

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return ""
        Get FieldName of hoDD iEntityField to sFieldName
        Function_Return sFieldName
    End_Function

    Function FieldType Handle hoDD Integer iField Returns Integer
        Integer iFieldCount iEntityField eType

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return C_TypeNone
        Get FieldType of hoDD iEntityField to eType
        Function_Return eType
    End_Function

    Function FieldPrecision Handle hoDD Integer iField Returns Integer
        Integer iFieldCount iEntityField iPrecision

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return 0
        Get FieldPrecision of hoDD iEntityField to iPrecision
        Function_Return iPrecision
    End_Function


    // Finds the parent field related to iField on hoDD.
    Function FieldRelation Handle hoDD Handle hoParentDD Integer iField Integer ByRef iRelatedField Returns Boolean
        Handle hParentEntity
        Integer iParent iFieldIndex iEntityField
        Boolean bRelated
        tDDParent[] aParents

        Move 0 to iRelatedField
        If (hoDD = 0 or hoParentDD = 0 or hoDD = hoParentDD) ;
            Function_Return False

        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= FieldCount(Self, hoDD)) ;
            Function_Return False

        Get phEntity of hoParentDD to hParentEntity
        Get paParents of hoDD to aParents
        For iParent from 0 to (SizeOfArray(aParents) - 1)
            If (aParents[iParent].hEntity = hParentEntity) Begin
                For iFieldIndex from 0 to (SizeOfArray(aParents[iParent].rel.aForeignKey) - 1)
                    If (aParents[iParent].rel.aForeignKey[iFieldIndex] = iEntityField) Begin
                        Move (aParents[iParent].rel.aRelatedKey[iFieldIndex] + 1) to iRelatedField
                        Move True to bRelated
                        Function_Return bRelated
                    End
                Loop
            End
        Loop

        Function_Return False
    End_Function

    // Converts a backend field type and precision to the DDP schema type.
    Function DDPTypeString Integer eType Integer iPrecision Returns String
        If (eType = C_TypeDate) Function_Return "date"

        If (eType = C_TypeNumber) Begin
            If (iPrecision > 0) Function_Return "decimal"
            Function_Return "integer"
        End

        If (eType = C_TypeReal or eType = C_TypeFloat or ;
            eType = C_TypeCurrency or eType = C_TypeDecimal) ;
            Function_Return "decimal"

        If (eType = C_TypeLongPtr or eType = C_TypeBigint or ;
            eType = C_TypeShort or eType = C_TypeUShort or ;
            eType = C_TypeULong or eType = C_TypeBiguint or ;
            eType = C_TypeInteger) ;
            Function_Return "integer"

        Function_Return "string"
    End_Function


    Function IsField Handle hoDD String sFieldName Integer ByRef iOptField Returns Boolean
        Integer iField iFieldCount
        String sField

        If (hoDD = 0) Function_Return False
        Get FieldCount hoDD to iFieldCount
        For iField from 1 to iFieldCount
            Get FieldName hoDD iField to sField
            If (Lowercase(sField) = Lowercase(sFieldName)) Begin
                If (num_arguments > 2) Move iField to iOptField
                Function_Return True
            End
        Loop

        Function_Return False
    End_Function

    Function CreateIndex Handle hoDD tDDPOrder[] aOrder tDDPConstrain[] aConstrains Integer iLimit Integer iOffset Returns Handle
        Handle hoIndex

        If (hoDD = 0) Function_Return 0

        Get Create (RefClass(cDDPNativeOrderedIndex)) to hoIndex
        Send Configure of hoIndex hoDD aOrder aConstrains iLimit iOffset
        Function_Return hoIndex
    End_Function

    Procedure DeleteIndex Handle hoDD Integer iIndex
        If (IsObjectOfClass(iIndex, (RefClass(cDDPNativeOrderedIndex)))) ;
            Send Destroy of iIndex
    End_Procedure

    Procedure Set_Constrains_To_Buffers tDDPTableQuery query
    End_Procedure

    Function AddConstrain Handle hoMainDD Handle hoDD Handle hField Integer eConstrain String sFilter Returns tDDPBuilderResult
        Integer eDbConstrain iField iFieldCount eType
        Date dValue
        tDDPBuilderResult oResult

        If (hoDD = 0) Begin
            Move DDPERR_INVALID_FIELD to oResult.iErr
            Move "Invalid constrain field." to oResult.sError
            Function_Return oResult
        End

        Get FieldCount hoDD to iFieldCount
        Move (hField - 1) to iField
        If (iField < 0 or iField >= iFieldCount) Begin
            Move DDPERR_INVALID_FIELD to oResult.iErr
            Move "Invalid constrain field." to oResult.sError
            Function_Return oResult
        End

        Case Begin
            Case (eConstrain = DDPFind_LT)
                Move C_DbConstraint_LT to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_LE)
                Move C_DbConstraint_LE to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_EQ)
                Move C_DbConstraint_EQ to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_GE)
                Move C_DbConstraint_GE to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_GT)
                Move C_DbConstraint_GT to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_NE)
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Constraint '_ne' is not supported." to oResult.sError
                Function_Return oResult
            Case Else
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Invalid constrain." to oResult.sError
                Function_Return oResult
        Case End

        Get FieldType hoDD hField to eType
        If (eType = C_TypeDate) Begin
            If (not(DDPParseISODate(sFilter, &dValue))) Begin
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Invalid date constraint; expected YYYY-MM-DD." to oResult.sError
                Function_Return oResult
            End
            Send Add_Value_Constraint of hoDD hoMainDD iField eDbConstrain dValue
        End
        Else ;
            Send Add_Value_Constraint of hoDD hoMainDD iField eDbConstrain sFilter
        Function_Return oResult
    End_Function

    // DDP runtime operations for the cross-platform data dictionary API.
    Procedure DDPLink Handle hoDD Handle hoRelated Boolean bClient Boolean bConstrain
        If (hoDD = 0 or hoRelated = 0) Procedure_Return

        Set DDO_Server of hoDD to hoRelated
        If (bConstrain) ;
            Set Constrain_File of hoDD to (Main_File(hoRelated))
    End_Procedure

    { Visibility = Private }
    Procedure DDPClearRelationsVisit Handle hoDD Handle[] ByRef aVisited
        Handle[] aChildren
        tDDParent[] aParents
        Integer iIndex

        If (hoDD = 0 or SearchArray(hoDD, aVisited) <> -1) Procedure_Return
        Move hoDD to aVisited[-1]

        Get paChildren of hoDD to aChildren
        For iIndex from 0 to (SizeOfArray(aChildren) - 1)
            Send DDPClearRelationsVisit aChildren[iIndex] (&aVisited)
        Loop

        Get paParents of hoDD to aParents
        For iIndex from 0 to (SizeOfArray(aParents) - 1)
            If (aParents[iIndex].hoDD <> 0) ;
                Send DDPClearRelationsVisit aParents[iIndex].hoDD (&aVisited)
        Loop

        Set Constrain_File of hoDD to C_UnresolvedObject
        Send Rebuild_Constraints of hoDD
        Send Clear of hoDD
    End_Procedure

    Procedure DDPClearRelations Handle hoDD Handle hoOptParentDD
        Handle[] aVisited

        If (hoOptParentDD <> 0) Move hoOptParentDD to aVisited[-1]
        Send DDPClearRelationsVisit hoDD (&aVisited)
    End_Procedure
    Procedure DDPRequestRead Handle hoDD Integer eMode Handle hFile Integer iIndex
        Integer iFindIndex

        If (iIndex > 0) Begin
            If (IsObjectOfClass(iIndex, (RefClass(cDDPNativeOrderedIndex)))) Begin
                Send ReadRecord of iIndex eMode
                Procedure_Return
            End
        End

        Move iIndex to iFindIndex
        If (iFindIndex = -1 and (eMode = FIRST_RECORD or eMode = NEXT_RECORD)) ;
            Move 1 to iFindIndex
        Send Find of hoDD eMode iFindIndex
    End_Procedure

    Procedure DDPRequestFind Handle hoDD Integer eMode Handle hFile Integer iIndex
        Integer iFindIndex

        If (iIndex > 0) Begin
            If (IsObjectOfClass(iIndex, (RefClass(cDDPNativeOrderedIndex)))) Begin
                Send ReadRecord of iIndex eMode
                Procedure_Return
            End
        End

        Move iIndex to iFindIndex
        If (iFindIndex = -1 and (eMode = FIRST_RECORD or eMode = NEXT_RECORD)) ;
            Move 1 to iFindIndex
        Send Find of hoDD eMode iFindIndex
    End_Procedure

    Procedure DDPSetFieldValue Handle hoDD Handle hFile Integer iField String sValue
        Integer iFieldCount iEntityField

        If (hoDD = 0) Procedure_Return
        Get Entity_Field_Count of hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Procedure_Return
        Set Entity_Field_Value of hoDD iEntityField to sValue
    End_Procedure

    Procedure DDPSetChangedValue Handle hoDD Handle hFile Integer iField String sValue
        Integer iFieldCount iEntityField

        If (hoDD = 0) Procedure_Return
        Get Entity_Field_Count of hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Procedure_Return
        Set Field_Changed_State of hoDD iEntityField to True
        Set Entity_Field_Value of hoDD iEntityField to sValue
    End_Procedure

    Function DDPGetFieldValue Handle hoDD Handle hFile Integer iField Returns String
        Integer iFieldCount iEntityField
        String sValue

        If (hoDD = 0) Function_Return ""
        Get Entity_Field_Count of hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return ""
        Get Entity_Field_Value of hoDD iEntityField to sValue
        Function_Return sValue
    End_Function

    Function DDPCurrentRowID Handle hoDD Handle hFile Returns RowID
        RowID riCurrent

        Move (NullRowID()) to riCurrent
        If (hoDD <> 0) Get CurrentRowID of hoDD to riCurrent
        Function_Return riCurrent
    End_Function

    Function DDPValidateDelete Handle hoDD Returns Boolean
        Function_Return (not(Can_Delete(hoDD)))
    End_Function

    Function DDPErrorText String sFallback Returns String
        Function_Return sFallback
    End_Function

End_Class
