Use WebApi\DDP\Backends\IBackend.pkg
Use Db\cDataDictionary.pkg

Struct tDDPCrossPlatformFileInfo
    Handle hFile
    tDDPFileDD[] aParents
    tDDPFileDD[] aChilds
End_Struct

Class cDDP_Backend_Mixin is a IDDP_Backend_Mixin
    Procedure Define_DDP_Backend_Mixin
        Property tDDPCrossPlatformFileInfo[] paFileInfo
    End_Procedure

    Procedure End_Define_DDP_Backend_Mixin
    End_Procedure

    { Visibility = Private }
    Function IsNumeric String sNumber Returns Boolean
        String sCompare
        Integer iLength iPosition

        Move "-0123456789" to sCompare
        Move (Length(sNumber)) to iLength
        For iPosition from 1 to iLength
            If (not(sCompare contains Mid(sNumber, iPosition, 1))) Function_Return False
        Loop
        Function_Return True
    End_Function

    { Visibility = Private }
    Function IsOptDottedNumeric String sNumber Returns Boolean
        String sCompare
        Integer iLength iPosition

        Move "-0123456789.," to sCompare
        Move (Length(sNumber)) to iLength
        For iPosition from 1 to iLength
            If (not(sCompare contains Mid(sNumber, iPosition, 1))) Function_Return False
        Loop
        Function_Return True
    End_Function

    Function IsObjectValidDataDictionary Handle hoDD Returns Boolean
        Handle hEntity

        If (IsObjectOfClass(hoDD, (RefClass(cDataDictionary))) = False) ;
            Function_Return False

        Get Main_File of hoDD to hEntity
        Function_Return (hEntity <> 0 and hEntity <> C_UnresolvedObject)
    End_Function

    Function NameOfDD Handle hoDD Returns String
        String sName

        Get Entity_Attribute of hoDD C_DbTableAttribute_DbName to sName
        Function_Return sName
    End_Function

    Function LoweredNameOfDD Handle hoDD Returns String
        Function_Return (Lowercase(NameOfDD(Self, hoDD)))
    End_Function

    Function IsValidIndexForDD Handle hoDD Integer iIndex Returns Boolean
        Integer iIndexCount

        If (hoDD = 0 or iIndex < 1) Function_Return False
        Get Entity_Index_Count of hoDD to iIndexCount
        Function_Return (iIndex <= iIndexCount)
    End_Function

    Function IsDDRelated Handle hoDD Handle hoTest Boolean ByRef bOptParent Returns Boolean
        Integer iInfoIndex iIndex
        tDDPCrossPlatformFileInfo oInfo
        tDDPCrossPlatformFileInfo[] aInfo

        If (num_arguments > 2) Move False to bOptParent
        If (hoDD = 0 or hoTest = 0) Function_Return False

        Get paFileInfo to aInfo
        Get Main_File of hoDD to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex = -1) Begin
            Error DFERR_PROGRAM "Non-exposed DD"
            Function_Return False
        End

        Get Main_File of hoTest to oInfo.hFile
        For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aParents) - 1)
            If (aInfo[iInfoIndex].aParents[iIndex].hFile = oInfo.hFile) Begin
                If (num_arguments > 2) Move True to bOptParent
                Function_Return True
            End
        Loop

        For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aChilds) - 1)
            If (aInfo[iInfoIndex].aChilds[iIndex].hFile = oInfo.hFile) Begin
                If (num_arguments > 2) Move False to bOptParent
                Function_Return True
            End
        Loop

        Function_Return False
    End_Function


    { MethodType = Event }
    Procedure OnExposeDD tDDPDataDictPair Def
    End_Procedure

    Function DFTypeToJson Integer eType Integer iPrecision Returns Integer
        If (eType = C_TypeNumber) Begin
            If (iPrecision > 0) Function_Return jsonTypeDouble
            Function_Return jsonTypeInteger
        End

        If (eType = C_TypeBoolean or eType = C_TypeBit) ;
            Function_Return jsonTypeBoolean

        If (eType = C_TypeReal or eType = C_TypeFloat or ;
            eType = C_TypeCurrency or eType = C_TypeDecimal) ;
            Function_Return jsonTypeDouble

        If (eType = C_TypeLongPtr or eType = C_TypeBigint or ;
            eType = C_TypeShort or eType = C_TypeUShort or ;
            eType = C_TypeULong or eType = C_TypeBiguint or ;
            eType = C_TypeInteger) ;
            Function_Return jsonTypeInteger

        If (eType = C_TypeNone) Function_Return jsonTypeNull
        Function_Return jsonTypeString
    End_Function

    Procedure SerializeField Handle hoJson tDDPTableQuery query Handle iFile Integer iField Boolean bForceField
        Integer iParent iRelatedField eType iPrecision iEntityField
        Boolean bRelated
        String sName
        Variant vValue

        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= FieldCount(Self, query.hoDD)) ;
            Procedure_Return

        If (not(bForceField)) Begin
            For iParent from 0 to (SizeOfArray(query.aParents) - 1)
                Get FieldRelation query.hoDD query.aParents[iParent].hoDD iField (&iRelatedField) to bRelated
                If (bRelated) Procedure_Return
            Loop
        End

        Get FieldName query.hoDD iField to sName
        Get FieldType query.hoDD iField to eType
        Get FieldPrecision query.hoDD iField to iPrecision
        Get Entity_Field_Value of query.hoDD iEntityField to vValue
        Send SetMemberValue of hoJson sName (DFTypeToJson(Self, eType, iPrecision)) vValue
    End_Procedure

    Procedure SerializeBufferToJson Handle hoJson tDDPTableQuery query
        Handle hFile
        Integer iField iFieldCount

        Get Main_File of query.hoDD to hFile
        Move (SizeOfArray(query.aFields)) to iFieldCount
        If (iFieldCount) Begin
            For iField from 0 to (iFieldCount - 1)
                Send SerializeField hoJson query hFile query.aFields[iField] True
            Loop
        End
        Else Begin
            Get FieldCount query.hoDD to iFieldCount
            For iField from 1 to iFieldCount
                Send SerializeField hoJson query hFile iField False
            Loop
        End
    End_Procedure

    Procedure StoreDDFileLayout Handle hoDD
        Integer iInfoIndex iInsert iInfo iRelation iRelationCount iSegment iSegmentCount
        Integer iParent iChild iChildParent
        Handle hMainFile hForeignEntity
        Boolean bAlready
        tDDPFileDD oComb
        tDDPCrossPlatformFileInfo oInfo
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Procedure_Return

        Get paFileInfo to aInfo
        Get Main_File of hoDD to hMainFile
        Move hMainFile to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex <> -1) Procedure_Return
        Move (BinarySearchInsertPos()) to iInsert

        // Store direct parent entities from the immutable entity metadata.
        Get Entity_Relation_Count of hoDD to iRelationCount
        Decrement iRelationCount
        For iRelation from 0 to iRelationCount
            Get Entity_Relation_Segment_Count of hoDD iRelation to iSegmentCount
            Decrement iSegmentCount
            For iSegment from 0 to iSegmentCount
                Get Entity_Relation_Segment_Foreign_Entity of hoDD iRelation iSegment to hForeignEntity
                If (hForeignEntity > 0) Begin
                    Move False to bAlready
                    For iParent from 0 to (SizeOfArray(oInfo.aParents) - 1)
                        If (oInfo.aParents[iParent].hFile = hForeignEntity) ;
                            Move True to bAlready
                    Loop

                    If (not(bAlready)) Begin
                        Move hForeignEntity to oComb.hFile
                        If (hForeignEntity = hMainFile) Begin
                            Move hoDD to oComb.hoDD
                        End
                        Else Begin
                            Get DDByFile oComb.hFile to oComb.hoDD
                        End
                        Move oComb to oInfo.aParents[-1]
                    End
                End
            Loop
        Loop

        // Add already-exposed children that point at this entity.
        For iInfo from 0 to (SizeOfArray(aInfo) - 1)
            For iChildParent from 0 to (SizeOfArray(aInfo[iInfo].aParents) - 1)
                If (aInfo[iInfo].aParents[iChildParent].hFile = hMainFile) Begin
                    Move hoDD to aInfo[iInfo].aParents[iChildParent].hoDD
                    Move False to bAlready
                    For iChild from 0 to (SizeOfArray(oInfo.aChilds) - 1)
                        If (oInfo.aChilds[iChild].hFile = aInfo[iInfo].hFile) ;
                            Move True to bAlready
                    Loop
                    If (not(bAlready)) Begin
                        Move aInfo[iInfo].hFile to oComb.hFile
                        Get DDByFile oComb.hFile to oComb.hoDD
                        Move oComb to oInfo.aChilds[-1]
                    End
                End
            Loop
        Loop

        // Update parent entries when this DD is exposed after its children.
        For iParent from 0 to (SizeOfArray(oInfo.aParents) - 1)
            Move oInfo.aParents[iParent].hFile to oComb.hFile
            Move hoDD to oComb.hoDD
            Move (BinarySearchArray(oComb, aInfo, False)) to iInfo
            If (iInfo <> -1) Begin
                Move False to bAlready
                For iChild from 0 to (SizeOfArray(aInfo[iInfo].aChilds) - 1)
                    If (aInfo[iInfo].aChilds[iChild].hFile = hMainFile) ;
                        Move True to bAlready
                Loop
                If (not(bAlready)) Move oComb to aInfo[iInfo].aChilds[-1]
            End
        Loop

        Move (InsertInArray(aInfo, iInsert, oInfo)) to aInfo
        Set paFileInfo to aInfo
    End_Procedure

    Function DDParents Handle hoDD Returns Handle[]
        Integer iIndex iInfoIndex
        Handle[] aHandles
        tDDPCrossPlatformFileInfo oInfo
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Function_Return aHandles
        Get paFileInfo to aInfo
        Get Main_File of hoDD to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex <> -1) Begin
            For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aParents) - 1)
                If (aInfo[iInfoIndex].aParents[iIndex].hoDD <> 0) ;
                    Move aInfo[iInfoIndex].aParents[iIndex].hoDD to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function

    Function DDChilds Handle hoDD Returns Handle[]
        Integer iIndex iInfoIndex
        Handle[] aHandles
        tDDPCrossPlatformFileInfo oInfo
        tDDPCrossPlatformFileInfo[] aInfo

        If (hoDD = 0) Function_Return aHandles
        Get paFileInfo to aInfo
        Get Main_File of hoDD to oInfo.hFile
        Move (BinarySearchArray(oInfo, aInfo, False)) to iInfoIndex
        If (iInfoIndex <> -1) Begin
            For iIndex from 0 to (SizeOfArray(aInfo[iInfoIndex].aChilds) - 1)
                If (aInfo[iInfoIndex].aChilds[iIndex].hoDD <> 0) ;
                    Move aInfo[iInfoIndex].aChilds[iIndex].hoDD to aHandles[-1]
            Loop
        End

        Function_Return aHandles
    End_Function

    Function DriverIndex String sDriver Returns Integer
        // Cross-platform database drivers are selected by connection URI, not
        // by a process-wide numeric driver table.
        Function_Return 0
    End_Function

    Function PrimaryDDIndex Handle hoDD Returns Integer
        Integer iIndexCount

        If (hoDD = 0) Function_Return 0

        Get Entity_Index_Count of hoDD to iIndexCount
        If (iIndexCount > 0) Function_Return 1
        Function_Return 0
    End_Function

    Function FieldCount Handle hoDD Returns Integer
        Integer iFieldCount

        If (hoDD = 0) Function_Return 0

        Get Entity_Field_Count of hoDD to iFieldCount
        Function_Return iFieldCount
    End_Function

    Function FieldName Handle hoDD Integer iField Returns String
        Integer iFieldCount iEntityField
        String sFieldName

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return ""

        Get Entity_Field_Attribute of hoDD iEntityField C_DbFieldAttribute_DbName to sFieldName
        Function_Return sFieldName
    End_Function
    // DDP field handles are 1-based; Entity field indexes are 0-based.
    Function FieldType Handle hoDD Integer iField Returns Integer
        Integer iFieldCount iEntityField eType

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return C_TypeNone

        Get Entity_Field_Type of hoDD iEntityField to eType
        Function_Return eType
    End_Function

    Function FieldPrecision Handle hoDD Integer iField Returns Integer
        Integer iFieldCount iEntityField iSeparator iPrecision
        String sSize

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return 0

        Move 0 to iPrecision
        Get Entity_Field_Attribute of hoDD iEntityField C_DbFieldAttribute_Size to sSize
        Move (Pos(".", sSize)) to iSeparator
        If (iSeparator > 0) ;
            Move (Trim(Right(sSize, Length(sSize) - iSeparator))) to iPrecision

        Function_Return iPrecision
    End_Function

    // Finds the parent field related to iField on hoDD.
    Function FieldRelation Handle hoDD Handle hoParentDD Integer iField Integer ByRef iRelatedField Returns Boolean
        Handle hParentEntity hForeignEntity
        Integer iFieldCount iRelationCount iSegmentCount iRelation iSegment iLocalField iEntityField

        Move 0 to iRelatedField
        If (hoDD = 0 or hoParentDD = 0 or hoDD = hoParentDD) ;
            Function_Return False

        Get FieldCount hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) ;
            Function_Return False

        Get Entity_StructHandle of hoParentDD to hParentEntity
        Get Entity_Relation_Count of hoDD to iRelationCount
        Decrement iRelationCount
        For iRelation from 0 to iRelationCount
            Get Entity_Relation_Segment_Count of hoDD iRelation to iSegmentCount
            Decrement iSegmentCount
            For iSegment from 0 to iSegmentCount
                Get Entity_Relation_Segment_Local_Field of hoDD iRelation iSegment to iLocalField
                If (iLocalField = iEntityField) Begin
                    Get Entity_Relation_Segment_Foreign_Entity of hoDD iRelation iSegment to hForeignEntity
                    If (hForeignEntity = hParentEntity) Begin
                        Get Entity_Relation_Segment_Foreign_Field of hoDD iRelation iSegment to iRelatedField
                        Increment iRelatedField
                        Function_Return True
                    End
                End
            Loop
        Loop

        Function_Return False
    End_Function

    Function IndexSegmentCount Handle hoDD Integer iIndex Returns Integer
        Integer iIndexCount iSegmentCount

        If (hoDD = 0 or iIndex < 1) Function_Return 0

        Get Entity_Index_Count of hoDD to iIndexCount
        If (iIndex > iIndexCount) Function_Return 0

        Decrement iIndex
        Get Entity_Index_Segment_Count of hoDD iIndex to iSegmentCount
        Function_Return iSegmentCount
    End_Function

    Function IndexSegmentField Handle hoDD Integer iIndex Integer iSegment Returns Integer
        Integer iIndexCount iSegmentCount iField

        If (hoDD = 0 or iIndex < 1 or iSegment < 1) Function_Return 0

        Get Entity_Index_Count of hoDD to iIndexCount
        If (iIndex > iIndexCount) Function_Return 0

        Decrement iIndex
        Get Entity_Index_Segment_Count of hoDD iIndex to iSegmentCount
        If (iSegment > iSegmentCount) Function_Return 0

        Decrement iSegment
        Get Entity_Index_Segment_Field of hoDD iIndex iSegment to iField
        Increment iField
        Function_Return iField
    End_Function

    // Converts a backend field type and precision to the DDP schema type.
    Function DDPTypeString Integer eType Integer iPrecision Returns String
        If (eType = C_TypeDate) Function_Return "date"

        If (eType = C_TypeNumber) Begin
            If (iPrecision > 0) Function_Return "decimal"
            Function_Return "integer"
        End

        If (eType = C_TypeReal or eType = C_TypeFloat or ;
            eType = C_TypeCurrency or eType = C_TypeDecimal) ;
            Function_Return "decimal"

        If (eType = C_TypeLongPtr or eType = C_TypeBigint or ;
            eType = C_TypeShort or eType = C_TypeUShort or ;
            eType = C_TypeULong or eType = C_TypeBiguint or ;
            eType = C_TypeInteger) ;
            Function_Return "integer"

        Function_Return "string"
    End_Function


    Function IsField Handle hoDD String sFieldName Integer ByRef iOptField Returns Boolean
        Integer iField iFieldCount
        String sField

        If (hoDD = 0) Function_Return False
        Get FieldCount hoDD to iFieldCount
        For iField from 1 to iFieldCount
            Get FieldName hoDD iField to sField
            If (Lowercase(sField) = Lowercase(sFieldName)) Begin
                If (num_arguments > 2) Move iField to iOptField
                Function_Return True
            End
        Loop

        Function_Return False
    End_Function

    Function CreateIndex Handle hoDD tDDPOrder[] aOrder Returns Handle
        Integer iIndex iIndexCount iSegment iSegmentCount iOrderCount
        Integer iExpectedField hActualField eActualMode
        Boolean bMatch

        If (hoDD = 0) Function_Return 0
        Move (SizeOfArray(aOrder)) to iOrderCount
        If (not(iOrderCount)) Function_Return (PrimaryDDIndex(Self, hoDD))

        Get Entity_Index_Count of hoDD to iIndexCount
        Decrement iIndexCount
        For iIndex from 0 to iIndexCount
            Get Entity_Index_Segment_Count of hoDD iIndex to iSegmentCount
            If (iSegmentCount = iOrderCount) Begin
                Move True to bMatch
                For iSegment from 0 to (iSegmentCount - 1)
                    Get Entity_Index_Segment_Field of hoDD iIndex iSegment to hActualField
                    Get Entity_Index_Segment_Mode of hoDD iIndex iSegment to eActualMode
                    Move (aOrder[iSegment].hField - 1) to iExpectedField
                    If (hActualField <> iExpectedField or eActualMode <> aOrder[iSegment].eMode) ;
                        Move False to bMatch
                Loop
                If (bMatch) Function_Return (iIndex + 1)
            End
        Loop

        // The cross-platform DB API has no mutable-index operation. Reuse an
        // equivalent declared index when possible; otherwise use the primary key.
        Function_Return (PrimaryDDIndex(Self, hoDD))
    End_Function

    Procedure DeleteIndex Handle hoDD Integer iIndex
        // CreateIndex only reuses declared indexes; there is no temporary index
        // to delete in the cross-platform database API.
    End_Procedure

    Procedure Set_Constrains_To_Buffers tDDPTableQuery query
        Integer iIndex iField

        For iIndex from 0 to (SizeOfArray(query.aConstrains) - 1)
            Move (query.aConstrains[iIndex].hField - 1) to iField
            Set Field_Current_Value of query.hoDD iField to query.aConstrains[iIndex].aParams[0]
        Loop

        For iIndex from 0 to (SizeOfArray(query.aParents) - 1)
            Send Set_Constrains_To_Buffers query.aParents[iIndex]
        Loop
    End_Procedure

    Function AddConstrain Handle hoMainDD Handle hoDD Handle hField Integer eConstrain String sFilter Returns tDDPBuilderResult
        Integer eDbConstrain iField iFieldCount
        Variant vValue
        tDDPBuilderResult oResult

        If (hoDD = 0) Begin
            Move DDPERR_INVALID_FIELD to oResult.iErr
            Move "Invalid constrain field." to oResult.sError
            Function_Return oResult
        End

        Get FieldCount hoDD to iFieldCount
        Move (hField - 1) to iField
        If (iField < 0 or iField >= iFieldCount) Begin
            Move DDPERR_INVALID_FIELD to oResult.iErr
            Move "Invalid constrain field." to oResult.sError
            Function_Return oResult
        End

        Case Begin
            Case (eConstrain = DDPFind_LT)
                Move C_DbConstraint_LT to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_LE)
                Move C_DbConstraint_LE to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_EQ)
                Move C_DbConstraint_EQ to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_GE)
                Move C_DbConstraint_GE to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_GT)
                Move C_DbConstraint_GT to eDbConstrain
                Case Break
            Case (eConstrain = DDPFind_NE)
                Move C_DbConstraint_NE to eDbConstrain
                Case Break
            Case Else
                Move DDPERR_INVALID_CONSTRAIN to oResult.iErr
                Move "Invalid constrain." to oResult.sError
                Function_Return oResult
        Case End

        Move sFilter to vValue
        Send Add_Value_Constraint of hoDD hoDD iField eDbConstrain vValue
        Function_Return oResult
    End_Function
    // DDP runtime operations for the cross-platform data dictionary API.
    Procedure DDPLink Handle hoDD Handle hoRelated Boolean bClient Boolean bConstrain
        If (hoDD = 0 or hoRelated = 0) Procedure_Return

        Set DDO_Server of hoDD to hoRelated
        If (bConstrain) ;
            Set Constrain_File of hoDD to (Main_File(hoRelated))
    End_Procedure

    Procedure DDPClearRelations Handle hoDD Handle hoOptParentDD
        Handle[] aChildren aEmptyChildren
        tDDParent[] aParents
        Integer iChild iParent

        If (hoDD = 0) Procedure_Return

        Get paChildren of hoDD to aChildren
        Set paChildren of hoDD to aEmptyChildren
        For iChild from 0 to (SizeOfArray(aChildren) - 1)
            If (num_arguments <= 1 or hoOptParentDD <> aChildren[iChild]) ;
                Send DDPClearRelations aChildren[iChild] hoDD
        Loop

        Get paParents of hoDD to aParents
        For iParent from 0 to (SizeOfArray(aParents) - 1)
            Move 0 to aParents[iParent].hoDD
            Move 0 to aParents[iParent].rel.hRelatedTable
        Loop
        Set paParents of hoDD to aParents
        Send UpdateEntity_Relations of hoDD

        Set Constrain_File of hoDD to C_UnresolvedObject
        Send Clear of hoDD
    End_Procedure

    Procedure DDPRequestRead Handle hoDD Integer eMode Handle hFile Integer iIndex
        Send Find of hoDD eMode iIndex
    End_Procedure

    Procedure DDPRequestFind Handle hoDD Integer eMode Handle hFile Integer iIndex
        Send Find of hoDD eMode iIndex
    End_Procedure

    Procedure DDPSetFieldValue Handle hoDD Handle hFile Integer iField String sValue
        Integer iFieldCount iEntityField

        Get FieldCount Self hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Procedure_Return
        Set Field_Current_Value of hoDD iEntityField to sValue
    End_Procedure

    Procedure DDPSetChangedValue Handle hoDD Handle hFile Integer iField String sValue
        Integer iFieldCount iEntityField

        Get FieldCount Self hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Procedure_Return
        Set Field_Changed_Value of hoDD iEntityField to sValue
    End_Procedure

    Function DDPGetFieldValue Handle hoDD Handle hFile Integer iField Returns String
        Integer iFieldCount iEntityField
        String sValue

        Get FieldCount Self hoDD to iFieldCount
        Move (iField - 1) to iEntityField
        If (iEntityField < 0 or iEntityField >= iFieldCount) Function_Return ""
        Get Field_Current_Value of hoDD iEntityField to sValue
        Function_Return sValue
    End_Function

    Function DDPValidateDelete Handle hoDD Returns Boolean
        Function_Return (not(Can_Delete(hoDD)))
    End_Function

    Function DDPErrorText String sFallback Returns String
        Function_Return sFallback
    End_Function

End_Class
