Use WebApi\cWebApiModifier.pkg
Use WebApi\cWebApiRouter.pkg

Use WebApi\DDP\Backends\IBackend.pkg
#IFDEF IS$CROSS_PLATFORM
Use WebApi\DDP\Backends\Main.pkg
#ELSE
Use WebApi\DDP\Backends\Windows.pkg
#ENDIF

Use WebApi\DDP\cDDPIterator.pkg
Use WebApi\DDP\cDDPRouter.pkg
Use WebApi\DDP\cDDPBuilder.pkg
Use WebApi\DDP\cDDPLegacyRequestParser.pkg
Use WebApi\DDP\cDDPDbMessageRequestParser.pkg

Use WebApi\DDP\v1\cDDPV1Router.pkg
Use WebApi\DDP\v1\cDDPQueryEndpoint.pkg
Use WebApi\DDP\v1\cDDPDeleteEndpoint.pkg
Use WebApi\DDP\v1\cDDPStoreEndpoint.pkg
Use WebApi\DDP\v1\cDDPUpdateEndpoint.pkg
Use WebApi\DDP\v1\cDDPSaveEndpoint.pkg
Use WebApi\DDP\v1\cDDPSchemaEndpoint.pkg

// Root handler for the Data Dictionary Protocol. Mount this at /ddp inside a cWebApi.
//
// URL layout:
//   GET  /ddp/v1             - protocol version + list of exposed tables
//   POST /ddp/v1/query       - execute a DDP query (nested, flat, or flatlinked)
//   POST /ddp/v1/delete      - delete a record identified by the request body (stub)
//   POST /ddp/v1/store       - create a new record (stub)
//   PUT|PATCH /ddp/v1/update - update an existing record identified by the request body (stub)
//   POST /ddp/v1/save        - write the records of one client Request_Save in one transaction
//
// Expose data dictionaries with Send Expose (RefClass(cMyDataDictionary)).
// Only exposed tables can be queried.
Class cWebAPIDataDictionaryProtocol is a cWebApiRouter

    Import_Class_Protocol cWebApiModifier_Mixin
    Import_Class_Protocol cDDP_Backend_Mixin
    Import_Class_Protocol cDDPDataSet_Mixin
    Import_Class_Protocol cDDPBuilder_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object

        Send Define_cWebApiModifier_Mixin
        Send Define_DDP_Backend_Mixin
        Send Define_cDDPDataSet_Mixin
        Send Define_cDDPBuilder_Mixin

        // The pbShow*ErrorDetail properties decide whether the client gets the full error text (True)
        // or psGenericErrorMessage (False). pbDebugMode of the cWebApi shows every detail; OnDDPError
        // can change the decision per error.

        // Request errors: wrong headers or verb, invalid JSON, unknown table or field, missing key, record not found (every DDPERR_* code not listed below).
        Property Boolean pbShowRequestErrorDetail True
        // Validation errors: DD validation rules that failed (DDPERR_VALIDATION_FAILED).
        Property Boolean pbShowValidationErrorDetail True
        // Database errors: a find, save, update or delete that failed (DDPERR_FIND_FAILED, DDPERR_SAVE_FAILED, DDPERR_UPDATE_FAILED, DDPERR_DELETE_FAILED). On Windows, /save validation failures also arrive here, and /delete validation failures on both backends (Request_Delete validates).
        Property Boolean pbShowDatabaseErrorDetail False
        // Unexpected errors: a DataFlex error outside a handled DDP path, sent as status 500 (DDPERR_UNEXPECTED).
        Property Boolean pbShowUnexpectedErrorDetail False
        // Client message for hidden errors; %1 is the reference that is also in the log entry.
        Property String psGenericErrorMessage "The server could not process the request. Reference: %1"

        // Iterator that serialises DDP responses as JSON using the application/ddp
        // content type. Stored as a property so OnPreRequest can attach it per-request.
        Object phoIterator is a cDDPIterator
        End_Object

        // Query request parsers, selected per request by the DDPFormat header
        // (see DDPRequestParser).
        Object oLegacyRequestParser is a cDDPLegacyRequestParser
        End_Object
        Object oDbMessageRequestParser is a cDDPDbMessageRequestParser
        End_Object

        // v1 versioned sub-router. Its RouteRequest tries children (query/find/delete/save)
        // first and falls back to handling GET /ddp/v1 itself. Sub-endpoints reach back
        // up to this object via Delegate Send/Get to call builder and backend methods.
        Object oV1Router is a cDDPV1Router
            Set psPath to "v1"

            Object oQueryEndpoint is a cDDPQueryEndpoint
                Set psPath to "query"
            End_Object

            Object oDeleteEndpoint is a cDDPDeleteEndpoint
                Set psPath to "delete"
            End_Object

            Object oStoreEndpoint is a cDDPStoreEndpoint
                Set psPath to "store"
            End_Object

            Object oUpdateEndpoint is a cDDPUpdateEndpoint
                Set psPath to "update"
            End_Object

            Object oSaveEndpoint is a cDDPSaveEndpoint
                Set psPath to "save"
            End_Object

            Object oSchemaEndpoint is a cDDPSchemaEndpoint
                Set psPath to "schema"
            End_Object
        End_Object
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        Send End_Define_Define_cWebApiModifier_Mixin_To_Self
        Send End_Define_cDDPDataSet_Mixin
        Send End_Define_cDDPBuilder_Mixin
    End_Procedure

    // Returns the request parser for a DDPFormat header value (case-insensitive):
    // "" or "legacy" = Legacy, "dbmessage" = DbMessage. Returns 0 for any other value.
    Function DDPRequestParser String sFormat Returns Handle
        Move (Lowercase(sFormat)) to sFormat
        If (sFormat = "" or sFormat = "legacy") Function_Return (oLegacyRequestParser(Self))
        If (sFormat = "dbmessage") Function_Return (oDbMessageRequestParser(Self))
        Function_Return 0
    End_Function

    // Try versioned sub-routers first (e.g. path contains "v1"). When no child path
    // segment matches - meaning the request is for /ddp itself - fall back to handling
    // the request at this level via OnHttpRequest (currently OPTIONS-only).
    { Visibility = Private }
    Procedure RouteRequest tWebApiCallContext ByRef webapicallcontext
        Integer iIndex
        Handle[] hoRoutables

        Move Self to webapicallcontext.hoRouter[-1]
        Send AddModifiersToCallContext (&webapicallcontext)

        Get RoutableIndex webapicallcontext.sPath to iIndex
        If (iIndex <> -1) Begin
            Get phoRoutables to hoRoutables
            Send RouteRequest of hoRoutables[iIndex] (&webapicallcontext)
        End
        Else Begin
            // No versioned sub-path matched - handle at the protocol root (OPTIONS etc.).
            Move Self to webapicallcontext.hoDataset
        End
    End_Procedure

    { MethodType = Event }
    Procedure OnPreRequest tWebApiCallContext ByRef webapicallcontext
        If (webapicallcontext.sContentType <> C_WebAPIDDP_Content_Type) Begin
            Send HandleDDPError (&webapicallcontext) DDPERR_INVALID_FORMAT C_WEBAPI_NOTFOUND "Not Found" ;
                (SFormat("Resource with path '%1' does not exist on the server", webapicallcontext.sPath))
            Procedure_Return
        End

        If (webapicallcontext.sAcceptType <> "" and ;
            webapicallcontext.sAcceptType <> "*/*" and ;
            webapicallcontext.sAcceptType <> C_WebAPIDDP_Content_Type) Begin
            Send HandleDDPError (&webapicallcontext) DDPERR_INVALID_FORMAT C_WEBAPI_BADREQUEST "Invalid Accept Type" ;
                (SFormat("Resource with path '%1' only accepts '%2'", webapicallcontext.sPath, C_WebAPIDDP_Content_Type))
            Procedure_Return
        End

        Move phoIterator to webapicallcontext.hoIterator
    End_Procedure

    // Fired for every DDP error response before it is logged and sent. The response and the log use
    // info.bShowDetail, info.iStatusCode, info.sTitle and info.sDetail after this event; in debug mode
    // (pbDebugMode of the cWebApi) the detail is shown regardless of info.bShowDetail.
    // info.aReportedErrors[].iNumber allows decisions per DataFlex error number.
    { MethodType = Event }
    Procedure OnDDPError tDDPErrorInfo ByRef info
    End_Procedure

    // YYYYMMDD-HHMMSS-XXXX, e.g. 20261117-140322-K7QM.
    { Visibility = Private }
    Function DDPErrorReference Returns String
        DateTime dtNow
        String sReference sAlphabet
        Integer iIndex

        Move "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" to sAlphabet
        Move (CurrentDateTime()) to dtNow
        Move (String(DateGetYear(dtNow)) + Right("0" + String(DateGetMonth(dtNow)), 2) + Right("0" + String(DateGetDay(dtNow)), 2) + "-" + ;
            Right("0" + String(DateGetHour(dtNow)), 2) + Right("0" + String(DateGetMinute(dtNow)), 2) + Right("0" + String(DateGetSecond(dtNow)), 2) + "-") to sReference
        For iIndex from 1 to 4
            Move (sReference + Mid(sAlphabet, 1, Mod(Random(32), 32) + 1)) to sReference
        Loop
        Function_Return sReference
    End_Function

    // Writes a DDP error with full detail to the WebApp Server event log. Override to log elsewhere,
    // or with an empty body to stop logging. The request body is not logged (it can contain passwords).
    Procedure LogDDPError tDDPErrorInfo info
        String sText sCRLF
        Integer iIndex

        Move (Character(13) + Character(10)) to sCRLF
        Move ("DDP error " + info.sReference) to sText
        Move (sText + sCRLF + info.sVerb + " " + info.sPath) to sText
        Move (sText + sCRLF + "Status: " + String(info.iStatusCode) + " " + info.sTitle) to sText
        Move (sText + sCRLF + "DDP error code: " + String(info.iErr)) to sText
        Move (sText + sCRLF + "Client detail: " + If(info.bShowDetail, "shown", "hidden")) to sText
        Move (sText + sCRLF + "Detail: " + info.sDetail) to sText
        For iIndex from 0 to (SizeOfArray(info.aReportedErrors) - 1)
            Move (sText + sCRLF + SFormat("DataFlex error %1 at line %2: %3", info.aReportedErrors[iIndex].iNumber, ;
                info.aReportedErrors[iIndex].iLine, info.aReportedErrors[iIndex].sText)) to sText
        Loop

        // Not LogErrorEvent: it raises an Error, which the request's own error tracking would catch.
        If (ghInetSession <> 0) Send LogEvent of ghInetSession info.iErr sText
    End_Procedure

    // Every DDP error response goes through here: decides what the client sees, fires OnDDPError,
    // logs the error and writes the response fields of webapicallcontext.
    Procedure HandleDDPError tWebApiCallContext ByRef webapicallcontext Integer iErr Integer iStatus String sTitle String sDetail
        tDDPErrorInfo info
        Boolean bDebugMode

        Move iErr to info.iErr
        Move iStatus to info.iStatusCode
        Move sTitle to info.sTitle
        Move sDetail to info.sDetail
        Move webapicallcontext.sVerb to info.sVerb
        Move webapicallcontext.sPath to info.sPath
        Get WebApiReportedErrors of webapicallcontext.hoApi to info.aReportedErrors
        Get DDPErrorReference to info.sReference

        Case Begin
            Case (iErr = DDPERR_VALIDATION_FAILED)
                Get pbShowValidationErrorDetail to info.bShowDetail
                Case Break
            Case (iErr = DDPERR_FIND_FAILED or iErr = DDPERR_SAVE_FAILED or iErr = DDPERR_UPDATE_FAILED or iErr = DDPERR_DELETE_FAILED)
                Get pbShowDatabaseErrorDetail to info.bShowDetail
                Case Break
            Case (iErr = DDPERR_UNEXPECTED)
                Get pbShowUnexpectedErrorDetail to info.bShowDetail
                Case Break
            Case Else
                Get pbShowRequestErrorDetail to info.bShowDetail
        Case End

        Send OnDDPError (&info)
        // After the event, so debug mode always shows the detail.
        Get pbDebugMode of webapicallcontext.hoApi to bDebugMode
        If (bDebugMode) Move True to info.bShowDetail
        Send LogDDPError info

        Move True to webapicallcontext.bErr
        Move info.iStatusCode to webapicallcontext.iStatusCode
        Move info.sTitle to webapicallcontext.sShortStatusMessage
        If (info.bShowDetail) Move info.sDetail to webapicallcontext.sErrorMessage
        Else Move (SFormat(psGenericErrorMessage(Self), info.sReference)) to webapicallcontext.sErrorMessage
    End_Procedure

End_Class
