Use Db\cDD_Required_mixin.pkg

Class cWebApiDDCompatibility_Mixin is a Mixin

    Function CompatibilityTableName Handle hoServer Integer iFile Returns String
        String sTableName

        Get Entity_Attribute of hoServer "Name" to sTableName

        Function_Return sTableName
    End_Function
    Function CompatibilityIsFieldIndexed Handle hoDD Integer iFile Integer iField Returns Boolean
        Boolean bIsIndexed

        Get IsFieldIndexed of hoDD iField to bIsIndexed

        Function_Return bIsIndexed
    End_Function

    Procedure CompatibilityBeginQueryFilters Handle hoDD String ByRef sOldSQLFilter Boolean ByRef bOldUseDDSQLFilters
    End_Procedure

    Procedure CompatibilityEndQueryFilters Handle hoDD String sOldSQLFilter Boolean bOldUseDDSQLFilters
    End_Procedure

    Function CompatibilityIsRequired Handle hoDD Integer iFile Integer iField Returns Boolean
        Boolean bRequired

        Get Field_Option_Boolean of hoDD iField DD_Required to bRequired

        Function_Return bRequired
    End_Function

    Function CompatibilityFieldValidationTable Handle hoDD Integer iFile Integer iField Returns Variant[][2]
        Variant[][2] avValidationTable

        // The CrossPlatform DD framework does not expose validation-table enumeration.
        Function_Return avValidationTable
    End_Function

    Function CompatibilityIsKeyField Handle hoDD Integer iField Returns Boolean
        String sPrimaryKey

        Get Entity_Field_Attribute of hoDD iField "PrimaryKey" to sPrimaryKey

        Function_Return (sPrimaryKey = "|CZ1" or Lowercase(sPrimaryKey)="on")
    End_Function

    Function CompatibilityFieldName Handle hoDD Integer iFile Integer iField Returns String
        String sFieldName

        Get Entity_Field_Attribute of hoDD iField "Name" to sFieldName

        Function_Return sFieldName
    End_Function

    Function CompatibilityFieldType Handle hoDD Integer iFile Integer iField Returns Integer
        Integer eFieldType

        Get Entity_Field_Type of hoDD iField to eFieldType

        Function_Return eFieldType
    End_Function

    Function CompatibilityFieldPrecision Handle hoDD Integer iFile Integer iField Integer eFieldType Returns Integer
        Function_Return -1
    End_Function

End_Class
