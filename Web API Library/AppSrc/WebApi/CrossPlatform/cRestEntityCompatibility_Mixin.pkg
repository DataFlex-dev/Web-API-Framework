Class cRestEntityCompatibility_Mixin is a Mixin

    Procedure CompatibilitySetFieldLocalValue Handle hoDD Handle hoServer Integer iFile Integer iField String sValue
        Integer iServerRelatedField

        Get RetrieveServerRelatedField to iServerRelatedField
    End_Procedure

    //Helper function to retrieve the server related field
    Function RetrieveServerRelatedField Returns Integer
        Handle hoDD hoServer hServerEntity hForeignEntity
        Integer iFile iRelField iField iRelationCount iSegmentCount iRelation iSegment iLocalField

        Get Main_DD to hoDD
        Get Server to hoServer
        Get Data_File to iFile
        Get Data_Field to iField

        If (hoDD = 0 or hoServer = 0) Begin
            Function_Return 0
        End

        Get Entity_StructHandle of hoServer to hServerEntity
        Get Entity_Relation_Count of hoDD to iRelationCount
        Decrement iRelationCount

        For iRelation from 0 to iRelationCount
            Get Entity_Relation_Segment_Count of hoDD iRelation to iSegmentCount
            Decrement iSegmentCount
            For iSegment from 0 to iSegmentCount
                Get Entity_Relation_Segment_Local_Field of hoDD iRelation iSegment to iLocalField
                If (iLocalField = iField) Begin
                    Get Entity_Relation_Segment_Foreign_Entity of hoDD iRelation iSegment to hForeignEntity
                    If (hForeignEntity = hServerEntity) Begin
                        Get Entity_Relation_Segment_Foreign_Field of hoDD iRelation iSegment to iRelField
                        Function_Return iRelField
                    End
                End
            Loop
        Loop

        Function_Return iRelField
    End_Function

    //Sets the Data_File and Data_Field of this object to the field that has a relation with the server.
    Procedure PrepareBinding
        Handle hoDD hoServer hServerEntity hForeignEntity
        Integer iRelationCount iSegmentCount iMainFile iRelation iSegment iField

        Get Main_DD to hoDD
        Get Server to hoServer

        If (hoDD = 0 or hoServer = 0) Begin
            Procedure_Return
        End

        Get Main_File of hoDD to iMainFile
        Get Entity_StructHandle of hoServer to hServerEntity
        Get Entity_Relation_Count of hoDD to iRelationCount
        Decrement iRelationCount

        For iRelation from 0 to iRelationCount
            Get Entity_Relation_Segment_Count of hoDD iRelation to iSegmentCount
            Decrement iSegmentCount
            For iSegment from 0 to iSegmentCount
                Get Entity_Relation_Segment_Foreign_Entity of hoDD iRelation iSegment to hForeignEntity
                If (hForeignEntity = hServerEntity) Begin
                    Get Entity_Relation_Segment_Local_Field of hoDD iRelation iSegment to iField
                    Set Data_File to iMainFile
                    Set Data_Field to iField
                    Procedure_Return
                End
            Loop
        Loop
    End_Procedure

End_Class
